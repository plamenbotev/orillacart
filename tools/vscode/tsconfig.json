{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node", "vscode"]
	},
	"include": ["src/**/*.ts", "../../assets/admin/extensions/editor/suggest.ts", "../../assets/admin/extensions/editor/ocs.ts"]
}
