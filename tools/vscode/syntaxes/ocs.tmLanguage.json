{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "OrillaCart script",
	"scopeName": "source.ocs",
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#declaration" },
		{ "include": "#string" },
		{ "include": "#number" },
		{ "include": "#keyword" },
		{ "include": "#atom" },
		{ "include": "#failure" },
		{ "include": "#filter" },
		{ "include": "#call" },
		{ "include": "#property" },
		{ "include": "#operator" }
	],
	"repository": {
		"comment": { "match": "#.*$", "name": "comment.line.number-sign.ocs" },
		"declaration": {
			"match": "^\\s*(extension|settings|payment_gateway|shipping_method|cart_rule|order_fee|price_adjuster|order_adjuster|checkout_field|order_action|order_column|product_column|order_filter|product_filter|home|assistant_tool|product_block|mailing_list|route|page|slot|template_data|object|fields|on|job|every)\\b",
			"captures": { "1": { "name": "storage.type.declaration.ocs" } }
		},
		"string": {
			"patterns": [
				{
					"begin": "\"", "end": "\"", "name": "string.quoted.double.ocs",
					"patterns": [ { "match": "\\\\(u[0-9A-Fa-f]{4}|[ntr\"\\\\])", "name": "constant.character.escape.ocs" } ]
				},
				{ "begin": "'", "end": "'", "name": "string.quoted.single.ocs" }
			]
		},
		"number": { "match": "\\b[0-9]+(\\.[0-9]+)?\\b", "name": "constant.numeric.ocs" },
		"keyword": {
			"match": "\\b(let|fn|if|elif|else|for|in|while|return|break|continue|try|catch|fail|and|or|not|is|starts with|ends with|not in)\\b",
			"name": "keyword.control.ocs"
		},
		"atom": { "match": "\\b(true|false|null)\\b", "name": "constant.language.ocs" },
		"failure": { "match": "\\b(unavailable|refused|error)(?=\\s*\\()", "name": "support.function.failure.ocs" },
		"filter": { "match": "\\|\\s*([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "entity.name.function.filter.ocs" } } },
		"call": {
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+)(?=\\s*\\()",
			"name": "support.function.host.ocs"
		},
		"property": { "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)", "name": "variable.other.property.ocs" },
		"operator": { "match": "(\\.\\.\\.|==|!=|<=|>=|\\?\\?|\\.\\.|//|[-+*/%~<>=?:|])", "name": "keyword.operator.ocs" }
	}
}
