{#
 # The customer's account. Visitors log in (WordPress's login), make an account, or have the link to an
 # order they placed as guests emailed to them; customers see their
 # orders, files and addresses.
 #
 # logged_in; accounts: optional | required | disabled; login_form (HTML); lost_password_url; confirm_token: the
 # token of an emailed link to make the account, for choosing its password; section: orders |
 # order | downloads | addresses | emails; urls: {orders, downloads, addresses, emails, logout}; orders (a page of them, with
 # order_urls and page_urls); order (null when not theirs); downloads; customer (with its address book);
 # max_addresses; default_country: where a new address starts; countries; states; newsletter: the words of its
 # box, when there is one to choose; subscribed; cart_reminders: whether the shop sends them.
 #}
{% import 'storefront/_macros.html.twig' as shop %}
<div class="orillacart-account">
    {% if not logged_in and confirm_token %}
        <section class="orillacart-account__confirm">
            <h2 class="orillacart-heading">{{ __('Choose your password') }}</h2>
            <p>{{ __('Your account is made as soon as you choose its password.') }}</p>
            <form data-orillacart-confirm novalidate>
                <input type="hidden" name="token" value="{{ confirm_token }}">
                <p class="orillacart-field">
                    <label for="confirm-password">{{ __('Password') }} <span aria-hidden="true">*</span></label>
                    <input id="confirm-password" type="password" name="password" autocomplete="new-password" minlength="8" required data-orillacart-field="password">
                    <small>{{ __('At least 8 characters.') }}</small>
                </p>
                <p class="orillacart-message" role="alert" data-orillacart-message></p>
                <button type="submit" class="wp-element-button orillacart-button">{{ __('Make my account') }}</button>
            </form>
        </section>
    {% elseif not logged_in %}
        <div class="orillacart-account__entry">
            <section class="orillacart-account__login">
                <h2 class="orillacart-heading">{{ __('Log in') }}</h2>
                {{ login_form|raw }}
                <p><a href="{{ lost_password_url }}">{{ __('Forgot your password?') }}</a></p>
            </section>
            {% if accounts != 'disabled' %}
                <section class="orillacart-account__register">
                    <h2 class="orillacart-heading">{{ __('Make an account') }}</h2>
                    <form data-orillacart-register novalidate>
                        <div class="orillacart-address__row">
                            {{ shop.input('register', 'first_name', __('First name'), '', 'given-name') }}
                            {{ shop.input('register', 'last_name', __('Last name'), '', 'family-name') }}
                        </div>
                        {{ shop.input('register', 'email', __('Email'), '', 'email', 'email') }}
                        {{ shop.honeypot('register.orillacart_website') }}
                        <p><small>{{ __('We email you a link to choose your password.') }}</small></p>
                        <p class="orillacart-message" role="alert" data-orillacart-message></p>
                        <button type="submit" class="wp-element-button orillacart-button">{{ __('Make an account') }}</button>
                    </form>
                </section>
            {% endif %}
            <section class="orillacart-account__find">
                <h2 class="orillacart-heading">{{ __('Find an order') }}</h2>
                <form data-orillacart-find-order novalidate>
                    {{ shop.input('find', 'number', __('Order number'), '', 'off', 'text') }}
                    {{ shop.input('find', 'email', __('Email the order was placed with'), '', 'email', 'email') }}
                    {{ shop.honeypot('find.orillacart_website') }}
                    <p><small>{{ __('We email the link to your order to that address.') }}</small></p>
                    <p class="orillacart-message" role="status" data-orillacart-message></p>
                    <button type="submit" class="wp-element-button orillacart-button">{{ __('Email me the link') }}</button>
                </form>
            </section>
        </div>
    {% else %}
        <nav class="orillacart-account__nav" aria-label="{{ __('Account') }}">
            <ul>
                <li><a href="{{ urls.orders }}"{{ section in ['orders', 'order'] ? ' aria-current="page"' }}>{{ __('Orders') }}</a></li>
                <li><a href="{{ urls.downloads }}"{{ section == 'downloads' ? ' aria-current="page"' }}>{{ __('Downloads') }}</a></li>
                <li><a href="{{ urls.addresses }}"{{ section == 'addresses' ? ' aria-current="page"' }}>{{ __('Addresses') }}</a></li>
                <li><a href="{{ urls.emails }}"{{ section == 'emails' ? ' aria-current="page"' }}>{{ __('Emails') }}</a></li>
                <li><a href="{{ urls.logout }}">{{ __('Log out') }}</a></li>
            </ul>
        </nav>

        <div class="orillacart-account__content">
            {% if section == 'order' %}
                <p><a href="{{ urls.orders }}">&larr; {{ __('All orders') }}</a></p>
                {% if order %}
                    {# translators: %d: order number -#}
                    <h2 class="orillacart-heading">{{ __('Order #%d')|format(order.number) }}</h2>
                    {% include 'storefront/receipt.html.twig' with {heading: false} %}
                {% else %}
                    <p class="orillacart-notice orillacart-notice--error">{{ __('There is no such order in your account.') }}</p>
                {% endif %}

            {% elseif section == 'downloads' %}
                {% if downloads %}
                    {% include 'storefront/_downloads.html.twig' with {show_order: true} %}
                {% else %}
                    <p class="orillacart-empty">{{ __('You have no files to download yet.') }}</p>
                {% endif %}

            {% elseif section == 'emails' %}
                <form class="orillacart-account__emails" data-orillacart-emails novalidate>
                    {% if newsletter %}
                        <p class="orillacart-field orillacart-field--check">
                            <input id="emails-newsletter" type="checkbox" name="newsletter" value="1"{{ subscribed ? ' checked' }}>
                            <label for="emails-newsletter">{{ newsletter }}</label>
                        </p>
                    {% endif %}
                    {% if cart_reminders %}
                        <p class="orillacart-field orillacart-field--check">
                            <input id="emails-cart-reminders" type="checkbox" name="cart_reminders" value="1"{{ customer.cart_reminders ?? true ? ' checked' }}>
                            <label for="emails-cart-reminders">{{ __('At checkout, offer to remind me of a cart I leave') }}</label>
                        </p>
                    {% else %}
                        <input type="hidden" name="cart_reminders" value="1">
                    {% endif %}
                    {% if newsletter or cart_reminders %}
                        <p><small>{{ __('Emails about your orders always come.') }}</small></p>
                        <p class="orillacart-message" role="status" data-orillacart-message></p>
                        <button type="submit" class="wp-element-button orillacart-button">{{ __('Save') }}</button>
                    {% else %}
                        <p class="orillacart-empty">{{ __('The shop only emails you about your orders.') }}</p>
                    {% endif %}
                </form>

            {% elseif section == 'addresses' %}
                <div class="orillacart-account__addresses">
                    {% for saved in customer.addresses ?? [] %}
                        <section class="orillacart-saved-address">
                            {{ shop.address_text(saved.address) }}
                            <p class="orillacart-saved-address__uses">
                                {%- if saved.billing %}<span class="orillacart-badge">{{ __('Billing') }}</span>{% endif -%}
                                {%- if saved.shipping %} <span class="orillacart-badge">{{ __('Shipping') }}</span>{% endif -%}
                            </p>
                            <p class="orillacart-message" role="alert" data-orillacart-message></p>
                            <details>
                                <summary>{{ __('Change') }}</summary>
                                {{ _self.address_form('address-' ~ saved.id, saved, countries, states) }}
                            </details>
                            <button type="button" class="wp-element-button orillacart-button orillacart-button--secondary" data-orillacart-remove-address="{{ saved.id }}">{{ __('Remove') }}</button>
                        </section>
                    {% else %}
                        <p class="orillacart-empty">{{ __('You have no saved addresses yet: checkout saves the ones you order with.') }}</p>
                    {% endfor %}
                    {% if (customer.addresses ?? [])|length < max_addresses %}
                        <details class="orillacart-saved-address orillacart-saved-address--new"{{ (customer.addresses ?? []) is empty ? ' open' }}>
                            <summary>{{ __('Add an address') }}</summary>
                            {{ _self.address_form('address-new', {address: {country: default_country}, billing: false, shipping: false}, countries, states) }}
                        </details>
                    {% endif %}
                </div>
                <script type="application/json" data-orillacart-states>{{ states|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>

            {% else %}
                {% if orders.orders %}
                    <table class="orillacart-table orillacart-account__orders">
                        <thead>
                            <tr>
                                <th scope="col">{{ __('Order') }}</th>
                                <th scope="col">{{ __('Date') }}</th>
                                <th scope="col">{{ __('Status') }}</th>
                                <th scope="col">{{ __('Total') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for summary in orders.orders %}
                                <tr>
                                    <td data-label="{{ __('Order') }}"><a href="{{ order_urls[summary.number] }}">#{{ summary.number }}</a></td>
                                    <td data-label="{{ __('Date') }}">{{ summary.placed_at|shop_date(false) }}</td>
                                    <td data-label="{{ __('Status') }}">{{ shop.status(summary.status) }}</td>
                                    <td data-label="{{ __('Total') }}">{{ summary.total|money(summary.currency) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% if orders.pages > 1 %}
                        <nav class="orillacart-pagination" aria-label="{{ __('Order pages') }}">
                            <ul>
                                {% for number, url in page_urls %}
                                    <li>{% if number == orders.page %}<span aria-current="page">{{ number }}</span>{% else %}<a href="{{ url }}">{{ number }}</a>{% endif %}</li>
                                {% endfor %}
                            </ul>
                        </nav>
                    {% endif %}
                {% else %}
                    <p class="orillacart-empty">{{ __('You have not ordered anything yet.') }}</p>
                    {% if links.shop %}<p><a class="wp-element-button orillacart-button" href="{{ links.shop }}">{{ __('Go to the shop') }}</a></p>{% endif %}
                {% endif %}
            {% endif %}
        </div>
    {% endif %}
    {{ slot('account_after', section ?? null) }}
</div>

{# A form for one address of the address book: saved (saved.id) or new. #}
{% macro address_form(prefix, saved, countries, states) %}
    {% import 'storefront/_macros.html.twig' as shop %}
    <form class="orillacart-saved-address__form" data-orillacart-address-book="{{ prefix }}"{{ saved.id is defined ? ' data-orillacart-address-id=' ~ saved.id }} novalidate>
        {{ shop.address(prefix, __('Address'), saved.address, countries, states, 'shipping') }}
        {% if not saved.billing %}
            <p class="orillacart-field orillacart-field--check">
                <input id="{{ prefix }}-billing" type="checkbox" name="billing" value="1">
                <label for="{{ prefix }}-billing">{{ __('Use for billing') }}</label>
            </p>
        {% endif %}
        {% if not saved.shipping %}
            <p class="orillacart-field orillacart-field--check">
                <input id="{{ prefix }}-shipping" type="checkbox" name="shipping" value="1">
                <label for="{{ prefix }}-shipping">{{ __('Use for shipping') }}</label>
            </p>
        {% endif %}
        <p class="orillacart-message" role="alert" data-orillacart-message></p>
        <button type="submit" class="wp-element-button orillacart-button">{{ __('Save address') }}</button>
    </form>
{% endmacro %}
