{#
 # The cart page. Quantities and removals go to the REST API; the storefront script then reloads this region.
 #
 # cart: the cart (lines, items, subtotal, orderable); product_urls: {product id: url}; links: the shop's pages;
 # coupons and discount: the codes entered and what they take off, as checkout prices them; estimate: the
 # checkout summary at the customer's saved address or the shop's, and estimated_for: that country's name;
 # shown: that summary too whenever checkout priced the cart, whose lines and subtotal stand in for the cart's,
 # so they add up to the estimate (with tax or without as the cart shows prices, at the customer's rate).
 #}
{% import 'storefront/_macros.html.twig' as shop %}
<div class="orillacart-cart" data-orillacart-region="cart">
    {{ slot('cart_before') }}
    {{ shop.needs_script(__('Turn on JavaScript in your browser to change the cart and check out.')) }}
    {% if cart.lines is empty %}
        <p class="orillacart-empty">{{ __('Your cart is empty.') }}</p>
        {% if links.shop %}<p><a class="wp-element-button orillacart-button" href="{{ links.shop }}">{{ __('Go to the shop') }}</a></p>{% endif %}
    {% else %}
        <table class="orillacart-table orillacart-cart__table">
            <thead>
                <tr>
                    <th scope="col">{{ __('Product') }}</th>
                    <th scope="col">{{ __('Price') }}</th>
                    <th scope="col">{{ __('Quantity') }}</th>
                    <th scope="col">{{ __('Total') }}</th>
                    <th scope="col"><span class="screen-reader-text">{{ __('Remove') }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for line in cart.lines %}
                    <tr data-orillacart-line="{{ line.id }}">
                        <td data-label="{{ __('Product') }}">
                            {% if product_urls[line.product_id] is defined %}<a href="{{ product_urls[line.product_id] }}">{{ line.name }}</a>{% else %}{{ line.name }}{% endif %}
                            {% for option in line.options %}
                                <br><small>{{ option.attribute }}: {{ option.option }}</small>
                            {% endfor %}
                            {{ shop.line_answers(line.personalisation) }}
                            {# translators: %d: how many of the item wait for stock -#}
                            {% if line.backordered > 0 %}<br><small class="orillacart-backorder">{{ __('%d on backorder: they ship when back in stock')|format(line.backordered) }}</small>{% endif %}
                            {% if line.contents %}<br><small class="orillacart-bundle">{{ __('Holds') }}: {% for item in line.contents %}{{ item.quantity }} × {{ item.name }}{{ not loop.last ? ', ' }}{% endfor %}</small>{% endif %}
                            {% if line.problem %}
                                <p class="orillacart-notice orillacart-notice--error">
                                    {%- if line.problem == 'unavailable' -%}
                                        {{ __('This is no longer for sale; remove it to check out.') }}
                                    {%- elseif line.problem == 'changed' -%}
                                        {{ __('Its choices changed: remove it and add it again.') }}
                                    {%- elseif line.problem == 'insufficient_stock' -%}
                                        {% if line.available > 0 %}{# translators: %d: how many are in stock -#}{{ __('Only %d in stock; lower the quantity to check out.')|format(line.available) }}{% else %}{{ __('Out of stock; remove it to check out.') }}{% endif %}
                                    {%- else -%}
                                        {{ line.message }}
                                    {%- endif -%}
                                </p>
                            {% endif %}
                        </td>
                        <td data-label="{{ __('Price') }}">{{ (shown ? shown.lines[loop.index0].unit_price : line.unit_price)|money(cart.currency) }}</td>
                        <td data-label="{{ __('Quantity') }}">
                            <input class="orillacart-quantity" type="number" min="1" max="{{ line.available ?? 999 }}" step="1" inputmode="numeric" value="{{ line.quantity }}"
                                {# translators: %s: product name -#}
                                aria-label="{{ __('Quantity of %s')|format(line.name) }}" data-orillacart-quantity="{{ line.id }}">
                        </td>
                        <td data-label="{{ __('Total') }}">{{ (shown ? shown.lines[loop.index0].total : line.total)|money(cart.currency) }}</td>
                        <td>
                            {# translators: %s: what is removed: a product, an attribute or a gift card -#}
                            <button type="button" class="orillacart-remove" data-orillacart-remove="{{ line.id }}" aria-label="{{ __('Remove %s')|format(line.name) }}">&times;</button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th scope="row" colspan="3">{{ __('Subtotal') }}</th>
                    <td colspan="2">{{ (shown ? shown.subtotal : cart.subtotal)|money(cart.currency) }}</td>
                </tr>
                {% if discount > 0 %}
                    <tr class="orillacart-discount">
                        <th scope="row" colspan="3">{{ __('Discount') }}</th>
                        <td colspan="2">−{{ discount|money(cart.currency) }}</td>
                    </tr>
                {% endif %}
                {% if estimate %}
                    {% if estimate.needs_shipping %}
                        <tr class="orillacart-estimate">
                            <th scope="row" colspan="3">{{ __('Shipping (estimated)') }}</th>
                            <td colspan="2">{{ estimate.shipping_option ? estimate.shipping|money(estimate.currency) : '—' }}</td>
                        </tr>
                    {% endif %}
                    {% if not estimate.prices_include_tax %}
                        {% for tax in estimate.taxes %}
                            {# translators: 1: tax name, 2: its rate -#}
                            <tr class="orillacart-estimate"><th scope="row" colspan="3">{{ __('%1$s (%2$s%%, estimated)')|format(tax.name, tax.percent) }}</th><td colspan="2">{{ tax.total|money(estimate.currency) }}</td></tr>
                        {% endfor %}
                    {% endif %}
                    <tr class="orillacart-total"><th scope="row" colspan="3">{{ __('Estimated total') }}</th><td colspan="2">{{ estimate.total|money(estimate.currency) }}</td></tr>
                    {% if estimate.prices_include_tax %}
                        {% for tax in estimate.taxes %}
                            {# translators: 1: tax name, 2: its rate -#}
                            <tr class="orillacart-included-tax"><th scope="row" colspan="3">{{ __('Including %1$s (%2$s%%)')|format(tax.name, tax.percent) }}</th><td colspan="2">{{ tax.total|money(estimate.currency) }}</td></tr>
                        {% endfor %}
                    {% endif %}
                {% endif %}
            </tfoot>
        </table>
        {% if estimate and estimate.minimum_short %}
            {# translators: 1: the least order, 2: how much more is needed -#}
            <p class="orillacart-notice orillacart-notice--error orillacart-minimum-order">{{ __('Orders start at %1$s. Add %2$s more to order.')|format(estimate.minimum_order|money(estimate.currency), estimate.minimum_short|money(estimate.currency)) }}</p>
        {% endif %}
        {% if estimate and estimate.free_shipping_short %}
            {# translators: %s: an amount of money -#}
            <p class="orillacart-notice orillacart-free-shipping">{{ __('Add %s more to your order for free shipping.')|format(estimate.free_shipping_short|money(estimate.currency)) }}</p>
        {% endif %}
        {% for refusal in cart.refusals %}
            <p class="orillacart-notice orillacart-notice--error">{{ refusal }}</p>
        {% endfor %}
        {% include 'storefront/_coupons.html.twig' with {coupons: coupons, currency: null} %}
        {{ slot('cart_after_totals') }}
        {% if estimate %}
            {# translators: %s: country name -#}
            <p class="orillacart-cart__note">{{ __('Estimated for delivery to %s. Checkout works out tax and shipping for your address.')|format(estimated_for) }}</p>
        {% else %}
            <p class="orillacart-cart__note">{{ __('Taxes and shipping are added at checkout.') }}</p>
        {% endif %}
        <p class="orillacart-message" role="status" data-orillacart-message></p>
        <div class="orillacart-cart__actions">
            {% if links.shop %}<a href="{{ links.shop }}">{{ __('Continue shopping') }}</a>{% endif %}
            {% if not cart.orderable %}
                <p class="orillacart-notice orillacart-notice--error">{{ __('Change the cart as marked above to check out.') }}</p>
            {% elseif links.checkout %}
                <a class="wp-element-button orillacart-button" href="{{ links.checkout }}">{{ __('Check out') }}</a>
            {% endif %}
        </div>
        {# The form posts and the page shows the cart with it: the cart's own script does not redraw the table for it. #}
        {% include 'storefront/_product_row.html.twig' with {title: __('You may also need'), products: cross_sells ?? [], cart_url: links.cart, class: 'orillacart-cross-sells', script: false} only %}
    {% endif %}
    {{ slot('cart_after') }}
</div>
