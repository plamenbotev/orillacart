{#
 # The checkout's summary: the items, how to ship, the totals and how to pay. Inside the checkout form.
 #}
{% import 'storefront/_macros.html.twig' as shop %}
<h2 class="orillacart-heading">{{ __('Your order') }}</h2>
<table class="orillacart-table orillacart-checkout__lines">
    <thead>
        <tr><th scope="col">{{ __('Product') }}</th><th scope="col">{{ __('Total') }}</th></tr>
    </thead>
    <tbody>
        {% for line in summary.lines %}
            <tr>
                <td>
                    {{ line.name }} &times; {{ line.quantity }}
                    {% if line.gift %}<br><small class="orillacart-gift">{{ __('Free gift') }}</small>{% endif %}
                    {% for option in line.options %}<br><small>{{ option.attribute }}: {{ option.option }}</small>{% endfor %}
                    {{ shop.line_answers(line.personalisation) }}
                    {% if line.contents %}<br><small class="orillacart-bundle">{{ __('Holds') }}: {% for item in line.contents %}{{ item.quantity }} × {{ item.name }}{{ not loop.last ? ', ' }}{% endfor %}</small>{% endif %}
                    {# translators: %d: how many of the item wait for stock -#}
                    {% if line.backordered > 0 %}<br><small class="orillacart-backorder">{{ __('%d on backorder: they ship when back in stock')|format(line.backordered) }}</small>{% endif %}
                </td>
                <td>{{ line.total|money(summary.currency) }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr><th scope="row">{{ __('Subtotal') }}</th><td>{{ summary.subtotal|money(summary.currency) }}</td></tr>
        {% if summary.discount > 0 %}
            <tr class="orillacart-discount"><th scope="row">{{ __('Discount') }}</th><td>−{{ summary.discount|money(summary.currency) }}</td></tr>
        {% endif %}
        {% if summary.needs_shipping %}
            <tr><th scope="row">{{ __('Shipping') }}</th><td>{{ summary.shipping_option ? summary.shipping|money(summary.currency) : '—' }}</td></tr>
        {% endif %}
        {% for fee in summary.fees %}
            <tr class="orillacart-fee"><th scope="row">{{ fee.label }}</th><td>{{ fee.amount|money(summary.currency) }}</td></tr>
        {% endfor %}
        {% if not summary.prices_include_tax %}
            {% for tax in summary.taxes %}
                <tr><th scope="row">{{ tax.name }} ({{ tax.percent }}%)</th><td>{{ tax.total|money(summary.currency) }}</td></tr>
            {% endfor %}
        {% endif %}
        <tr class="orillacart-total"><th scope="row">{{ __('Total') }}</th><td>{{ summary.total|money(summary.currency) }}</td></tr>
        {% if summary.gift_card_total > 0 %}
            {% for card in summary.gift_cards|filter(card => not card.refused and card.amount > 0) %}
                <tr class="orillacart-gift-card-paid"><th scope="row">{{ card.label }}</th><td>−{{ card.amount|money(summary.currency) }}</td></tr>
            {% endfor %}
            <tr class="orillacart-amount-due"><th scope="row">{{ __('To pay') }}</th><td>{{ summary.amount_due|money(summary.currency) }}</td></tr>
        {% endif %}
        {% if summary.prices_include_tax %}
            {% for tax in summary.taxes %}
                {# translators: 1: tax name, 2: its rate -#}
                <tr class="orillacart-included-tax"><th scope="row">{{ __('Including %1$s (%2$s%%)')|format(tax.name, tax.percent) }}</th><td>{{ tax.total|money(summary.currency) }}</td></tr>
            {% endfor %}
        {% endif %}
    </tfoot>
</table>
{% if summary.estimated_for %}
    <p class="orillacart-notice">{{ __('Tax and shipping are estimated until you enter your address.') }}</p>
{% endif %}
{% if summary.minimum_short %}
    {# translators: 1: the least order, 2: how much more is needed -#}
    <p class="orillacart-notice orillacart-notice--error orillacart-minimum-order">{{ __('Orders start at %1$s. Add %2$s more to order.')|format(summary.minimum_order|money(summary.currency), summary.minimum_short|money(summary.currency)) }}</p>
{% endif %}
{% if summary.free_shipping_short %}
    {# translators: %s: an amount of money -#}
    <p class="orillacart-notice orillacart-free-shipping">{{ __('Add %s more to your order for free shipping.')|format(summary.free_shipping_short|money(summary.currency)) }}</p>
{% endif %}

{% include 'storefront/_coupons.html.twig' with {coupons: summary.coupons, currency: summary.currency} %}
{% include 'storefront/_gift_cards.html.twig' with {summary: summary} %}

{% if summary.needs_shipping %}
    <fieldset class="orillacart-choices" data-orillacart-field="shipping_option">
        <legend>{{ __('Shipping') }}</legend>
        {% for option in summary.shipping_options %}
            <p class="orillacart-choice">
                {% set field_id = 'orillacart-shipping-' ~ option.id|replace({':': '-'}) %}
                <input id="{{ field_id }}" type="radio" name="shipping_option" value="{{ option.id }}"{{ option.id == summary.shipping_option ? ' checked' }} data-orillacart-rate>
                <label for="{{ field_id }}">{{ option.carrier }}: {{ option.name }} <strong>{{ option.total|money(summary.currency) }}</strong>
                    {%- if option.collect_at %}<br><small class="orillacart-choice__note">{{ option.collect_at.address }}{% if option.collect_at.hours %} · {{ option.collect_at.hours }}{% endif %}</small>{% endif -%}
                </label>
            </p>
        {% else %}
            {% if address_known and summary.ships_from %}
                {# translators: %s: an amount of money -#}
                <p class="orillacart-notice">{{ __('Delivery to this address needs an order of at least %s.')|format(summary.ships_from|money(summary.currency)) }}</p>
            {% else %}
                <p class="orillacart-notice">{{ address_known ? __('We cannot ship your order to this address.') : __('Enter your address to see the ways to ship.') }}</p>
            {% endif %}
        {% endfor %}
        {% if summary.delivery %}
            {% if summary.delivery.days %}
                <p class="orillacart-field">
                    <label for="orillacart-delivery-date">{{ __('Day of delivery') }}{% if summary.delivery.required %} <span aria-hidden="true">*</span>{% endif %}</label>
                    <select id="orillacart-delivery-date" name="delivery_date"{{ summary.delivery.required ? ' required' }} data-orillacart-delivery data-orillacart-field="delivery_date">
                        {% if not summary.delivery.required %}<option value="">{{ __('Whenever the courier comes') }}</option>{% endif %}
                        {% for day in summary.delivery.days %}
                            <option value="{{ day.date }}"{{ day.date == summary.delivery_date ? ' selected' }}>{{ day.date|shop_day }}</option>
                        {% endfor %}
                    </select>
                </p>
                {% for day in summary.delivery.days %}
                    {% if day.date == summary.delivery_date and day.slots %}
                        <p class="orillacart-field">
                            <label for="orillacart-delivery-slot">{{ __('Time of delivery') }} <span aria-hidden="true">*</span></label>
                            <select id="orillacart-delivery-slot" name="delivery_slot" required data-orillacart-field="delivery_slot">
                                {% for slot in day.slots %}
                                    {# translators: %s: a time of day, such as 09:00–12:00 -#}
                                    <option value="{{ slot.id }}"{{ slot.id == summary.delivery_slot ? ' selected' }}{{ slot.full ? ' disabled' }}>{{ slot.full ? __('%s (fully booked)')|format(slot.label) : slot.label }}</option>
                                {% endfor %}
                            </select>
                        </p>
                    {% endif %}
                {% endfor %}
            {% elseif summary.delivery.required %}
                <p class="orillacart-notice orillacart-notice--error">{{ __('There is no day left to deliver on soon. Choose another way to ship.') }}</p>
            {% endif %}
        {% endif %}
        {% if summary.pickup_points %}
            <p class="orillacart-field">
                <label for="orillacart-pickup-point">{{ __('Pick it up from') }} <span aria-hidden="true">*</span></label>
                <select id="orillacart-pickup-point" name="pickup_point" required data-orillacart-field="pickup_point">
                    <option value="">{{ __('Choose an office or locker') }}</option>
                    {% for point in summary.pickup_points %}
                        <option value="{{ point.id }}"{{ point.id == summary.pickup_point ? ' selected' }}>{{ point.name }}, {{ point.address }}{{ point.hours ? ' (' ~ point.hours ~ ')' }}</option>
                    {% endfor %}
                </select>
            </p>
        {% endif %}
    </fieldset>
{% endif %}

{% if summary.needs_payment %}
    <fieldset class="orillacart-choices" data-orillacart-field="payment">
        <legend>{{ __('Payment') }}</legend>
        {% for method in summary.payment_methods %}
            <div class="orillacart-choice">
                <input id="orillacart-payment-{{ method.gateway }}" type="radio" name="payment" value="{{ method.gateway }}"{{ method.gateway == summary.payment_method ? ' checked' }} data-orillacart-payment>
                {# translators: %s: an amount of money -#}
                <label for="orillacart-payment-{{ method.gateway }}">{{ method.name }}{% if summary.payment_fees[method.gateway] is defined %} <small>{{ __('(+ %s fee)')|format(summary.payment_fees[method.gateway]|money(summary.currency)) }}</small>{% endif %}</label>
                {% if method.instructions %}<p class="orillacart-choice__note">{{ method.instructions|nl2br }}</p>{% endif %}
            </div>
        {% else %}
            <p class="orillacart-notice">{{ __('There is no way to pay for an order to this address.') }}</p>
        {% endfor %}
    </fieldset>
{% endif %}

{% if summary.import_charges %}
    <p class="orillacart-notice orillacart-import-charges">{{ __('Your order ships from abroad: import VAT and duties may be due on delivery, paid to the carrier or customs.') }}</p>
{% endif %}
{% if summary.reverse_charge %}
    <p class="orillacart-notice">{{ __('Reverse charge: your business accounts for the VAT, so none is charged.') }}</p>
{% elseif summary.vat_message %}
    <p class="orillacart-notice">{{ summary.vat_message }}</p>
{% endif %}

<input type="hidden" name="expected_total" value="{{ summary.total }}">
<p class="orillacart-message" role="alert" data-orillacart-message></p>
{{ slot('checkout_before_place_order') }}
<button type="submit" class="wp-element-button orillacart-button orillacart-checkout__place">{{ __('Place order') }}</button>
