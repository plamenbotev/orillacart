{#
 # One product as the shop lists it: its picture, name, stars, price, and the way to buy it.
 # product (ProductCards), cart_url, heading (h2, h3), script (false: the form posts and the page reloads).
 #}
{% import 'storefront/_macros.html.twig' as shop %}
<li class="orillacart-product-card" data-product="{{ product.offer.id }}">
    <a class="orillacart-product-card__link" href="{{ product.url }}">
        {% if product.image %}{{ product.image|raw }}{% else %}<span class="orillacart-product-card__no-image" aria-hidden="true"></span>{% endif %}
        <{{ heading }} class="orillacart-product-card__name">{{ product.offer.name }}</{{ heading }}>
    </a>
    {% if product.rating %}
        <p class="orillacart-product-card__rating">{% include 'storefront/_stars.html.twig' with {rating: product.rating.average} only %} <small>({{ product.rating.count }})</small></p>
    {% endif %}
    <p class="orillacart-product-card__price">{{ shop.price(product.offer) }}</p>
    {% include 'storefront/_product_buy.html.twig' with {product: product, cart_url: cart_url, script: script ?? true} only %}
</li>
