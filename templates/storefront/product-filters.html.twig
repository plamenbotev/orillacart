{#
 # The shop's filters on their own (the Product filters block): action, the page that lists the products;
 # hidden: [{name, value}], the words, category and sort to keep; panel, see _filters.html.twig.
 #}
<div class="orillacart-product-filters" data-orillacart-region="filters">
    <form method="get" action="{{ action }}" data-orillacart-filters aria-label="{{ __('Filter products') }}">
        {% for field in hidden %}<input type="hidden" name="{{ field.name }}" value="{{ field.value }}">{% endfor %}
        {% include 'storefront/_filters.html.twig' with {panel: panel} %}
        <button type="submit" class="wp-element-button orillacart-button orillacart-product-filters__apply">{{ __('Show products') }}</button>
    </form>
</div>
