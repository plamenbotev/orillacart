{#
 # The buying part of a product page, below the product's description.
 #
 # offer: the product (price, sale, stock, choices); gallery: its images, featured first ({src, srcset, sizes,
 # alt, thumb}); variations: each variation with its price already formatted, image, gallery and description,
 # for the script that shows the chosen one; cart_url: null when the shop has no cart page.
 #
 # The script shows a chosen picture in the theme's featured image (img.wp-post-image), or in the stage here
 # when the page has none.
 #}
{% import 'storefront/_macros.html.twig' as shop %}
<section class="orillacart-product" aria-label="{{ __('Buy') }}">
    <div class="orillacart-gallery__stage" data-orillacart-stage hidden></div>
    <div class="orillacart-gallery" data-orillacart-gallery data-images="{{ gallery|json_encode }}"{{ gallery|length < 2 ? ' hidden' }}>
        {% for image in gallery %}
            {# translators: %d: image number -#}
            <button type="button" class="orillacart-gallery__thumb" data-orillacart-image="{{ loop.index0 }}" aria-label="{{ __('Show image %d')|format(loop.index) }}">
                <img src="{{ image.thumb }}" alt="{{ image.alt }}" width="64" height="64" loading="lazy">
            </button>
        {% endfor %}
    </div>
    <p class="orillacart-product__price" data-orillacart-price>{{ shop.price(offer) }}</p>
    {% if offer.contents %}
        <div class="orillacart-product__contents">
            <p class="orillacart-heading">{{ __('In the box') }}</p>
            <ul>{% for item in offer.contents %}<li>{{ item.quantity }} × {{ item.name }}</li>{% endfor %}</ul>
        </div>
    {% endif %}
    {% if offer.tiers and not offer.price_hidden %}
        <table class="orillacart-table orillacart-product__tiers">
            <caption>{{ __('Buy more, pay less') }}</caption>
            <thead><tr><th scope="col">{{ __('Quantity') }}</th><th scope="col">{{ __('Price each') }}</th></tr></thead>
            <tbody>
                {% for tier in offer.tiers %}
                    <tr>
                        {# translators: %d: quantity -#}
                        <td>{{ loop.last ? __('%d or more')|format(tier.min_quantity) : (tier.min_quantity == offer.tiers[loop.index].min_quantity - 1 ? tier.min_quantity : tier.min_quantity ~ '–' ~ (offer.tiers[loop.index].min_quantity - 1)) }}</td>
                        <td>{{ tier.price|money }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <p class="orillacart-product__description" data-orillacart-variation-description hidden></p>

    {% if offer.sku %}
        <p class="orillacart-product__sku">{{ __('SKU') }}: <span data-orillacart-sku>{{ offer.sku }}</span></p>
    {% endif %}

    <p class="orillacart-stock" data-orillacart-stock>
        {%- if offer.price_hidden -%}
        {%- elseif not offer.for_sale -%}
            <span class="orillacart-stock--out">{{ __('Not available') }}</span>
        {%- elseif offer.on_backorder -%}
            <span class="orillacart-stock--backorder">{{ __('On backorder: ships when it is back in stock') }}</span>
        {%- elseif offer.available is not null -%}
            {# translators: %d: how many are in stock -#}
            {{ __('%d in stock')|format(offer.available) }}
        {%- endif -%}
    </p>

    {% if (offer.for_sale or offer.bundle_choices) and cart_url and not offer.price_hidden %}
        <form class="orillacart-add-to-cart" data-orillacart-add-to-cart data-cart-url="{{ cart_url }}" data-variations="{{ variations|json_encode }}"{% if offer.bundle_choices %} data-bundle="{{ offer.id }}"{% endif %}>
            <input type="hidden" name="product_id" value="{{ offer.id }}">
            {% for attribute in offer.attributes %}
                <p class="orillacart-field">
                    <label for="orillacart-attribute-{{ attribute.id }}">
                        {{ attribute.name }}{% if attribute.required or offer.variations %} <span aria-hidden="true">*</span>{% endif %}
                    </label>
                    <select id="orillacart-attribute-{{ attribute.id }}" name="option_ids" data-orillacart-option{{ attribute.required or offer.variations ? ' required' }}>
                        <option value="">{{ attribute.required or offer.variations ? __('Choose an option') : __('None') }}</option>
                        {% for option in attribute.options %}
                            <option value="{{ option.id }}">
                                {{- option.name -}}
                                {%- if not offer.variations and not attribute.price_hidden and option.adjustment != '0' %} ({{ option.adjustment starts with '-' ? '' : '+' }}{{ option.adjustment_kind == 'percent' ? option.adjustment ~ '%' : option.adjustment|money }}){% endif -%}
                            </option>
                        {% endfor %}
                    </select>
                </p>
            {% endfor %}
            {% for item in offer.bundle_choices %}
                {% set label = item.quantity > 1 ? item.quantity ~ ' × ' ~ item.name : item.name %}
                {% if item.choices|length == 1 and item.optional %}
                    {% set choice = item.choices|first %}
                    <p class="orillacart-field orillacart-field--check">
                        <label>
                            <input type="checkbox" name="bundle_choices" value="{{ choice.id }}" data-orillacart-bundle-choice{{ choice.for_sale ? '' : ' disabled' }}>
                            {# translators: %s: product or option name -#}
                            {{ __('Add %s')|format(label) }}{% if choice.price is not null %} (+{{ choice.price|money }}){% endif %}{% if not choice.for_sale %} – {{ __('Not available') }}{% endif %}
                        </label>
                    </p>
                {% else %}
                    <p class="orillacart-field">
                        <label for="orillacart-bundle-{{ offer.id }}-{{ loop.index }}">
                            {{ label }}{% if not item.optional %} <span aria-hidden="true">*</span>{% endif %}
                        </label>
                        <select id="orillacart-bundle-{{ offer.id }}-{{ loop.index }}" name="bundle_choices" data-orillacart-bundle-choice{{ item.optional ? '' : ' required' }}>
                            {% if item.optional %}<option value="">{{ __('None') }}</option>{% endif %}
                            {% for choice in item.choices %}
                                <option value="{{ choice.id }}"{{ choice.for_sale ? '' : ' disabled' }}>
                                    {{- choice.name -}}
                                    {%- if choice.price is not null %} (+{{ choice.price|money }}){% endif -%}
                                    {%- if not choice.for_sale %} – {{ __('Not available') }}{% endif -%}
                                </option>
                            {% endfor %}
                        </select>
                    </p>
                {% endif %}
            {% endfor %}
            <div class="orillacart-add-to-cart__buy">
                <p class="orillacart-field orillacart-field--quantity">
                    <label for="orillacart-quantity-{{ offer.id }}">{{ __('Quantity') }}</label>
                    <input id="orillacart-quantity-{{ offer.id }}" type="number" name="quantity" value="1" min="1" max="{{ offer.available ?? 999 }}" step="1" inputmode="numeric" required>
                </p>
                <button type="submit" class="wp-element-button orillacart-button"{{ offer.for_sale ? '' : ' disabled' }}>{{ __('Add to cart') }}</button>
            </div>
            <p class="orillacart-message" role="status" data-orillacart-message></p>
        </form>
    {% endif %}

    {% if offer.downloads %}
        <div class="orillacart-product__downloads">
            <h2 class="orillacart-heading">{{ __('Files you get') }}</h2>
            <ul>
                {% for name in offer.downloads %}<li>{{ name }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}
</section>
