{#
 # The buying part of a product page, below the product's description, where the page's template has none of the
 # product blocks: its pictures, price and the way to buy it (see the partials).
 #}
<section class="orillacart-product" aria-label="{{ __('Buy') }}" data-orillacart-for="{{ offer.id }}"{% if recently_viewed ?? false %} data-orillacart-viewed="{{ offer.id }}"{% endif %}>
    {% include 'storefront/_product_gallery.html.twig' %}
    {% include 'storefront/_product_price.html.twig' %}
    {% include 'storefront/_product_form.html.twig' %}
</section>
