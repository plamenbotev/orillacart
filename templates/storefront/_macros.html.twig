{#
 # Pieces the storefront templates share. A theme can override this file like any other (orillacart/storefront/_macros.html.twig).
 #}

{# A product's price today: a sale shows the regular price struck through; products with variations show where prices start. #}
{% macro price(offer) %}
    {%- if offer.price_hidden -%}
        <span class="orillacart-price orillacart-price--hidden">{{ __('Ask us for the price') }}</span>
    {%- else -%}
        {%- if offer.highest_price -%}
            {# translators: %s: the lowest price -#}
            <span class="orillacart-price">{{ __('From %s')|format(offer.price|money) }}</span>
        {%- elseif offer.regular_price -%}
            <span class="orillacart-price orillacart-price--sale"><del aria-label="{{ __('Regular price') }}">{{ offer.regular_price|money }}</del> <ins aria-label="{{ __('Sale price') }}">{{ offer.price|money }}</ins></span>
            {%- if offer.lowest_price %} <small class="orillacart-price__lowest">{{ __('Lowest price in the last 30 days: %s')|format(offer.lowest_price|money) }}</small>{% endif -%}
        {%- else -%}
            <span class="orillacart-price">{{ offer.price|money }}</span>
        {%- endif -%}
        {%- if prices_include_tax() %} <small class="orillacart-price__tax">{{ __('incl. tax') }}</small>{% endif -%}
    {%- endif -%}
{% endmacro %}

{% macro status(status) %}
    {%- set labels = {
        pending_payment: __('Waiting for payment'),
        on_hold: __('On hold'),
        processing: __('Processing'),
        shipped: __('Shipped'),
        completed: __('Completed'),
        cancelled: __('Cancelled'),
        failed: __('Payment failed'),
        refunded: __('Refunded'),
    } -%}
    <span class="orillacart-status orillacart-status--{{ status }}">{{ labels[status] ?? status }}</span>
{%- endmacro %}

{#
 # Address fields named for the REST API: prefix.first_name and so on. The state list is filled for the chosen
 # country; the storefront script refills it when the country changes.
 #}
{% macro address(prefix, title, address, countries, states, section) %}
    {%- set country = address.country ?? '' -%}
    {%- set country_states = states[country] ?? [] -%}
    <fieldset class="orillacart-address" data-orillacart-address="{{ prefix }}">
        <legend>{{ title }}</legend>
        <div class="orillacart-address__row">
            {{ _self.input(prefix, 'first_name', __('First name'), address.first_name ?? '', section ~ ' given-name') }}
            {{ _self.input(prefix, 'last_name', __('Last name'), address.last_name ?? '', section ~ ' family-name') }}
        </div>
        {{ _self.input(prefix, 'street', __('Street address'), address.street ?? '', section ~ ' street-address') }}
        <div class="orillacart-address__row">
            {{ _self.input(prefix, 'city', __('City'), address.city ?? '', section ~ ' address-level2') }}
            {{ _self.input(prefix, 'postcode', __('Postcode'), address.postcode ?? '', section ~ ' postal-code') }}
        </div>
        <div class="orillacart-address__row">
            <p class="orillacart-field">
                <label for="{{ prefix }}-country">{{ __('Country') }} <span aria-hidden="true">*</span></label>
                <select id="{{ prefix }}-country" name="{{ prefix }}.country" autocomplete="{{ section }} country" required data-orillacart-country data-orillacart-field="{{ prefix }}.country">
                    <option value="">{{ __('Choose a country') }}</option>
                    {% for option in countries %}
                        <option value="{{ option.code }}"{{ option.code == country ? ' selected' }}>{{ option.name }}</option>
                    {% endfor %}
                </select>
            </p>
            <p class="orillacart-field" data-orillacart-state-field{{ country_states is empty ? ' hidden' }}>
                <label for="{{ prefix }}-state">{{ __('State') }} <span aria-hidden="true">*</span></label>
                <select id="{{ prefix }}-state" name="{{ prefix }}.state" autocomplete="{{ section }} address-level1" data-orillacart-state data-orillacart-field="{{ prefix }}.state"{{ country_states is empty ? ' disabled' : ' required' }}>
                    <option value="">{{ __('Choose a state') }}</option>
                    {% for option in country_states %}
                        <option value="{{ option.code }}"{{ option.code == (address.state ?? '') ? ' selected' }}>{{ option.name }}</option>
                    {% endfor %}
                </select>
            </p>
        </div>
        {{ _self.input(prefix, 'phone', __('Phone'), address.phone ?? '', section ~ ' tel', 'tel') }}
    </fieldset>
{% endmacro %}

{# A field people do not see and leave empty, and programs fill in: the shop refuses what comes with it filled. #}
{% macro honeypot(name = 'orillacart_website') %}
    <p class="orillacart-honeypot" aria-hidden="true"><label>{{ __('Leave this empty') }} <input type="text" name="{{ name }}" value="" tabindex="-1" autocomplete="off"></label></p>
{% endmacro %}

{% macro input(prefix, name, label, value, autocomplete, type = 'text') %}
    <p class="orillacart-field">
        <label for="{{ prefix }}-{{ name }}">{{ label }} <span aria-hidden="true">*</span></label>
        <input id="{{ prefix }}-{{ name }}" type="{{ type }}" name="{{ prefix }}.{{ name }}" value="{{ value }}" autocomplete="{{ autocomplete }}" required data-orillacart-field="{{ prefix }}.{{ name }}">
    </p>
{% endmacro %}

{# An address in its country's layout (the filter orillacart_address_format changes it), then the phone. #}
{% macro address_text(address) %}
    <address class="orillacart-address-text">
        {%- for line in address|address_lines %}{{ line }}<br>{% endfor -%}
        {{ address.phone }}
    </address>
{% endmacro %}

{#
 # The questions add-ons ask in one part of checkout (billing, shipping or order), named fields.<id> for the
 # REST API.
 #}
{% macro extra_fields(fields, section) %}
    {%- for field in fields %}{% if field.section == section %}
        {%- set id = 'orillacart-field-' ~ field.id -%}
        {%- set required = field.required ? ' <span aria-hidden="true">*</span>' : '' -%}
        {% if field.kind == 'checkbox' %}
            <p class="orillacart-field orillacart-field--check">
                <input id="{{ id }}" type="checkbox" name="fields.{{ field.id }}" value="1" data-orillacart-field="fields.{{ field.id }}"{{ field.required ? ' required' }}>
                <label for="{{ id }}">{{ field.label }}{{ required|raw }}</label>
                {% if field.help %}<small>{{ field.help }}</small>{% endif %}
            </p>
        {% else %}
            <p class="orillacart-field">
                <label for="{{ id }}">{{ field.label }}{{ required|raw }}</label>
                {% if field.kind == 'textarea' %}
                    <textarea id="{{ id }}" name="fields.{{ field.id }}" rows="3" maxlength="{{ field.longest }}" data-orillacart-field="fields.{{ field.id }}"{{ field.required ? ' required' }}></textarea>
                {% elseif field.kind == 'choice' %}
                    <select id="{{ id }}" name="fields.{{ field.id }}" data-orillacart-field="fields.{{ field.id }}"{{ field.required ? ' required' }}>
                        <option value="">{{ __('Choose') }}</option>
                        {% for choice in field.choices %}<option value="{{ choice.value }}">{{ choice.label }}</option>{% endfor %}
                    </select>
                {% else %}
                    <input id="{{ id }}" type="text" name="fields.{{ field.id }}" maxlength="{{ field.longest }}" data-orillacart-field="fields.{{ field.id }}"{{ field.required ? ' required' }}>
                {% endif %}
                {% if field.help %}<small>{{ field.help }}</small>{% endif %}
            </p>
        {% endif %}
    {% endif %}{% endfor -%}
{% endmacro %}

{# The answers an order keeps to add-ons' questions. #}
{% macro field_answers(fields) %}
    {%- if fields %}
        <dl class="orillacart-answers">
            {% for field in fields %}<dt>{{ field.label }}</dt><dd>{{ field.answer|nl2br }}</dd>{% endfor %}
        </dl>
    {% endif -%}
{% endmacro %}
