{#
 # An order as its customer sees it: after checkout (by a link to it) and in their account.
 #
 # order: the order; receipt: a link's token for it, which paying it now needs; heading: whether to thank the
 # customer for ordering;
 # links: the shop's pages; pay_methods: the ways an unpaid order can be paid now, if any; invoices: its
 # invoices and credit notes, if any; returns: its returns, and what may still go back, if the shop takes returns.
 #}
{% import 'storefront/_macros.html.twig' as shop %}
<div class="orillacart-receipt">
    {% if heading %}
        <h2 class="orillacart-heading">{{ order.status in ['failed', 'cancelled'] ? __('Your order was not completed') : __('Thank you for your order') }}</h2>
    {% endif %}

    <ul class="orillacart-receipt__facts">
        <li>{{ __('Order') }}: <strong>#{{ order.number }}</strong></li>
        <li>{{ __('Placed') }}: <strong>{{ order.placed_at|shop_date }}</strong></li>
        <li>{{ __('Status') }}: <strong>{{ shop.status(order.status) }}</strong></li>
        <li>{{ __('Total') }}: <strong>{{ order.total|money(order.currency) }}</strong></li>
        {% if order.refunded_total > 0 %}<li>{{ __('Refunded') }}: <strong>{{ order.refunded_total|money(order.currency) }}</strong></li>{% endif %}
        {% if order.payment_name %}<li>{{ __('Payment') }}: <strong>{{ order.payment_name }}</strong></li>{% endif %}
        {% if order.vat_number %}<li>{{ __('VAT number') }}: <strong>{{ order.vat_number }}</strong>{% if order.reverse_charge %} ({{ __('reverse charge: no VAT') }}){% endif %}</li>{% endif %}
        {% for invoice in invoices ?? [] %}
            <li>{{ invoice.kind == 'credit_note' ? __('Credit note') : __('Invoice') }}: <a href="{{ invoice.url }}" target="_blank" rel="noopener">{{ invoice.number }}</a></li>
        {% endfor %}
    </ul>

    {% if order.payment_note and order.status in ['pending_payment', 'on_hold'] %}
        <div class="orillacart-notice">{{ order.payment_note|nl2br }}</div>
    {% endif %}

    {% if pay_methods is defined and pay_methods and receipt is defined %}
        <form class="orillacart-pay-now" id="pay" data-orillacart-pay-now="{{ receipt }}">
            <h3 class="orillacart-heading">{{ __('Pay now') }}</h3>
            <p>{{ order.status == 'failed' ? __('The payment did not go through. Try again, with the same or another way to pay.') : __('The order waits for its payment. Pay it now, or choose another way to pay.') }}</p>
            <fieldset class="orillacart-choices" data-orillacart-field="payment">
                <legend>{{ __('Payment') }}</legend>
                {% set gateways = pay_methods|map(method => method.gateway) %}
                {% set chosen = order.payment_gateway in gateways ? order.payment_gateway : gateways|first %}
                {% for method in pay_methods %}
                    <div class="orillacart-choice">
                        <input id="orillacart-pay-{{ method.gateway }}" type="radio" name="payment" value="{{ method.gateway }}"{{ method.gateway == chosen ? ' checked' }}>
                        <label for="orillacart-pay-{{ method.gateway }}">{{ method.name }}</label>
                        {% if method.instructions %}<p class="orillacart-choice__note">{{ method.instructions|nl2br }}</p>{% endif %}
                    </div>
                {% endfor %}
            </fieldset>
            <p class="orillacart-message" role="alert" data-orillacart-message></p>
            {# translators: %s: the order's total -#}
            <button type="submit" class="wp-element-button orillacart-button">{{ __('Pay %s')|format(order.total|money(order.currency)) }}</button>
        </form>
    {% endif %}

    {% if order.downloads %}
        <h3 class="orillacart-heading">{{ __('Downloads') }}</h3>
        {% include 'storefront/_downloads.html.twig' with {downloads: order.downloads, show_order: false} %}
    {% endif %}

    <h3 class="orillacart-heading">{{ __('Items') }}</h3>
    <table class="orillacart-table orillacart-receipt__lines">
        <thead>
            <tr><th scope="col">{{ __('Product') }}</th><th scope="col">{{ __('Total') }}</th></tr>
        </thead>
        <tbody>
            {% for line in order.lines %}
                <tr>
                    <td>
                        {{ line.name }} &times; {{ line.quantity }}
                        {% for option in line.options %}<br><small>{{ option.attribute }}: {{ option.option }}</small>{% endfor %}
                        {# translators: %d: how many of the item wait for stock -#}
                        {% if line.backorder_shown and line.backordered > 0 %}<br><small class="orillacart-backorder">{{ __('%d on backorder: they ship when back in stock')|format(line.backordered) }}</small>{% endif %}
                        {% if line.contents %}<br><small class="orillacart-bundle">{{ __('Holds') }}: {% for item in line.contents %}{{ item.quantity }} × {{ item.name }}{{ not loop.last ? ', ' }}{% endfor %}</small>{% endif %}
                        {# translators: %d: quantity -#}
                        {% if line.refunded_quantity > 0 %}<br><small>{{ __('%d refunded')|format(line.refunded_quantity) }}</small>{% endif %}
                        {% if (review_links ?? {})[line.product_id] is defined %}<br><a class="orillacart-receipt__review" href="{{ review_links[line.product_id] }}">{{ __('Review it') }}</a>{% endif %}
                    </td>
                    <td>{{ line.total|money(order.currency) }}</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr><th scope="row">{{ __('Subtotal') }}</th><td>{{ order.subtotal|money(order.currency) }}</td></tr>
            {% for discount in order.discounts %}
                <tr class="orillacart-discount"><th scope="row">{{ discount.automatic ? discount.description : __('Coupon %s')|format(discount.code) }}</th><td>{{ discount.free_shipping ? __('Free shipping') : '−' ~ discount.amount|money(order.currency) }}</td></tr>
            {% endfor %}
            {% if order.shipping %}
                <tr><th scope="row">{{ __('Shipping') }} ({{ order.shipping }})</th><td>{{ order.shipping_total|money(order.currency) }}</td></tr>
            {% endif %}
            {% for fee in order.fees %}
                <tr class="orillacart-fee"><th scope="row">{{ fee.label }}</th><td>{{ fee.amount|money(order.currency) }}</td></tr>
            {% endfor %}
            {% if not order.prices_include_tax %}
                {% for tax in order.taxes %}
                    <tr><th scope="row">{{ tax.name }} ({{ tax.percent }}%)</th><td>{{ tax.amount|money(order.currency) }}</td></tr>
                {% endfor %}
            {% endif %}
            <tr class="orillacart-total"><th scope="row">{{ __('Total') }}</th><td>{{ order.total|money(order.currency) }}</td></tr>
            {% if order.prices_include_tax %}
                {% for tax in order.taxes %}
                    {# translators: 1: tax name, 2: its rate -#}
                    <tr class="orillacart-included-tax"><th scope="row">{{ __('Including %1$s (%2$s%%)')|format(tax.name, tax.percent) }}</th><td>{{ tax.amount|money(order.currency) }}</td></tr>
                {% endfor %}
            {% endif %}
            {% if order.refunded_total > 0 %}
                <tr><th scope="row">{{ __('Refunded') }}</th><td>−{{ order.refunded_total|money(order.currency) }}</td></tr>
            {% endif %}
        </tfoot>
    </table>

    {% if order.note %}
        <h3 class="orillacart-heading">{{ __('Your note') }}</h3>
        <p>{{ order.note|nl2br }}</p>
    {% endif %}

    {% if order.notes %}
        <h3 class="orillacart-heading">{{ __('Messages from the shop') }}</h3>
        <ul class="orillacart-receipt__notes">
            {% for note in order.notes %}
                <li><time datetime="{{ note.created_at }}">{{ note.created_at|shop_date }}</time> {{ note.text|nl2br }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <div class="orillacart-receipt__addresses">
        <div>
            <h3 class="orillacart-heading">{{ order.shipping_address ? __('Billing address') : __('Address') }}</h3>
            {{ shop.address_text(order.billing) }}
            <p>{{ order.email }}</p>
        </div>
        {% if order.shipping_address %}
            <div>
                <h3 class="orillacart-heading">{{ __('Shipping address') }}</h3>
                {{ shop.address_text(order.shipping_address) }}
            </div>
        {% endif %}
        {% if shipments ?? [] %}
            <div>
                <h3 class="orillacart-heading">{{ __('Shipments') }}</h3>
                <ul>
                    {% for shipment in shipments %}
                        <li>
                            {{ shipment.carrier }} {{ shipment.number }}{% if shipment.tracking %}: {{ shipment.tracking }}{% endif %}{% if shipment.tracking_url %} — <a href="{{ shipment.tracking_url }}">{{ __('Follow it') }}</a>{% endif %}
                            {% if shipments|length > 1 %}<br><small>{% for item in shipment.items %}{{ item.quantity }} × {{ item.name }}{{ not loop.last ? ', ' }}{% endfor %}</small>{% endif %}
                            {% if shipment.parcels|length > 1 %}
                                {# translators: shown before the tracking numbers of a shipment's parcels -#}
                                <br><small>{{ __('Parcels:') }} {% for parcel in shipment.parcels %}{% if parcel.tracking_url %}<a href="{{ parcel.tracking_url }}">{{ parcel.number }}</a>{% else %}{{ parcel.number }}{% endif %}{{ not loop.last ? ', ' }}{% endfor %}</small>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
        {% if order.delivery_date %}
            <div>
                <h3 class="orillacart-heading">{{ __('Delivery') }}</h3>
                <p>{{ order.delivery_date|shop_day }}{% if order.delivery_slot %}, {{ order.delivery_slot }}{% endif %}</p>
            </div>
        {% endif %}
        {% if order.pickup_point %}
            <div>
                <h3 class="orillacart-heading">{{ __('Pickup point') }}</h3>
                <p>{{ order.pickup_point }}</p>
            </div>
        {% endif %}
    </div>
    {% if returns is defined and returns and (returns.returns or returns.accepting) %}
        {% set reasons = {damaged: __('It arrived damaged'), wrong_item: __('It is not what I ordered'), not_as_described: __('It is not as described'), no_longer_needed: __('I no longer need it'), other: __('Another reason')} %}
        {% set states = {requested: __('Asked; the shop will answer'), approved: __('Approved: send the items back'), refused: __('Refused'), received: __('The items came back'), refunded: __('Refunded')} %}
        <h3 class="orillacart-heading" id="returns">{{ __('Returns') }}</h3>
        {% for item_return in returns.returns %}
            <div class="orillacart-return">
                <p><strong>{% for item in item_return.items %}{{ item.quantity }} × {{ item.name }}{{ not loop.last ? ', ' }}{% endfor %}</strong> — {{ states[item_return.status] ?? item_return.status }}</p>
                {% if item_return.answer %}<p class="orillacart-return__answer">{{ item_return.answer|nl2br }}</p>{% endif %}
            </div>
        {% endfor %}
        {% if returns.accepting and receipt is defined %}
            <form class="orillacart-return-form" data-orillacart-return="{{ receipt }}">
                {# translators: %s: a date -#}
                <p>{{ __('You may ask to send items back until %s.')|format(returns.until|shop_day) }}</p>
                {% for item in returns.returnable %}
                    <p class="orillacart-field">
                        <label for="orillacart-return-{{ item.line }}">{{ item.name }}</label>
                        <select id="orillacart-return-{{ item.line }}" name="items.{{ item.line }}" data-orillacart-return-line="{{ item.line }}">
                            {% for quantity in 0..item.quantity %}<option value="{{ quantity }}">{{ quantity }}</option>{% endfor %}
                        </select>
                    </p>
                {% endfor %}
                <p class="orillacart-field">
                    <label for="orillacart-return-reason">{{ __('Why') }}</label>
                    <select id="orillacart-return-reason" name="reason">
                        {% for value, label in reasons %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                    </select>
                </p>
                <p class="orillacart-field">
                    <label for="orillacart-return-comment">{{ __('Anything to add') }}</label>
                    <textarea id="orillacart-return-comment" name="comment" maxlength="1000" rows="3"></textarea>
                </p>
                <p class="orillacart-message" role="alert" data-orillacart-message></p>
                <button type="submit" class="wp-element-button orillacart-button">{{ __('Ask to return these items') }}</button>
            </form>
        {% endif %}
    {% endif %}
    {% if order.fields %}
        <h3 class="orillacart-heading">{{ __('Other details') }}</h3>
        {{ shop.field_answers(order.fields) }}
    {% endif %}
    {% if receipt is defined %}
        <form class="orillacart-receipt__reorder" data-orillacart-reorder="{{ receipt }}"{{ links.cart ?? false ? ' data-orillacart-cart-url=' ~ links.cart }} novalidate>
            <p class="orillacart-message" role="status" data-orillacart-message></p>
            <button type="submit" class="wp-element-button orillacart-button orillacart-button--secondary">{{ __('Order these again') }}</button>
        </form>
    {% endif %}
    {{ slot('receipt_after', order.number) }}
</div>
