{#
 # The shop: products in a grid, with categories, search, sorting and pages.
 #
 # products: [{offer, url, image (HTML), simple}]; categories: [{name, url, current, image (HTML or empty)}], the top ones,
 # current "page" for the one chosen, "true" above it; subcategories: [{name, url, current}], below the one chosen (or beside it); all_url, all_current; search; sort;
 # sorts: {value: label}; sort_chosen: the shopper chose the sort (kept without the choice shown); page; pages;
 # page_links, previous_url, next_url (see _pagination.html.twig); columns; cart_url (null without a cart page);
 # show_filters; panel (see _filters.html.twig); hidden: [{name, value}] the choices kept without the panel;
 # filtered (anything chosen); layout: grid or list; layout_urls: {grid, list}; view: the shopper's own, kept by the form;
 # card_html: [{id, html}] each product's card from the shop's own card blocks, else null for the shop's card;
 # show: {categories, search, sort, layouts, count, pagination}, the parts around the grid (each on unless turned off,
 # for a theme placing them in blocks of their own); first, last, total: the count.
 #}
{% import 'storefront/_macros.html.twig' as shop %}
<div class="orillacart-products" data-orillacart-region="products">
    {% if categories and (show.categories ?? true) %}
        <nav class="orillacart-categories" aria-label="{{ __('Product categories') }}">
            <ul>
                <li><a href="{{ all_url }}"{{ all_current ? ' aria-current="page"' }}>{{ __('All products') }}</a></li>
                {% for category in categories %}
                    <li><a href="{{ category.url }}"{% if category.current %} aria-current="{{ category.current }}"{% endif %}>{{ category.image|raw }}{{ category.name }}</a></li>
                {% endfor %}
            </ul>
            {% if subcategories %}
                <ul class="orillacart-categories__below">
                    {% for category in subcategories %}
                        <li><a href="{{ category.url }}"{{ category.current ? ' aria-current="page"' }}>{{ category.name }}</a></li>
                    {% endfor %}
                </ul>
            {% endif %}
        </nav>
    {% endif %}

    <form class="orillacart-products__filters" method="get" action="{{ base_url }}" role="search" data-orillacart-filters>
        {% if current_category %}<input type="hidden" name="category" value="{{ current_category }}">{% endif %}
        {% if show.search ?? true %}
            <p class="orillacart-field">
                <label for="orillacart-product-search">{{ __('Search products') }}</label>
                <input id="orillacart-product-search" type="search" name="q" value="{{ search }}">
            </p>
        {% elseif search %}
            <input type="hidden" name="q" value="{{ search }}">
        {% endif %}
        {% if show.sort ?? true %}
            <p class="orillacart-field">
                <label for="orillacart-product-sort">{{ __('Sort by') }}</label>
                <select id="orillacart-product-sort" name="sort">
                    {% for value, label in sorts %}
                        <option value="{{ value }}"{{ value == sort ? ' selected' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </p>
        {% elseif sort_chosen %}
            <input type="hidden" name="sort" value="{{ sort }}">
        {% endif %}
        {% if (show.search ?? true) or (show.sort ?? true) %}
            <button type="submit" class="wp-element-button orillacart-button">{{ __('Show') }}</button>
        {% endif %}

        {% if view %}<input type="hidden" name="view" value="{{ view }}">{% endif %}
        {% for field in hidden %}<input type="hidden" name="{{ field.name }}" value="{{ field.value }}">{% endfor %}
        {% if show_filters %}
            {% include 'storefront/_filters.html.twig' with {panel: panel} %}
        {% endif %}
    </form>

    {% if products %}
        {% if show.count ?? true %}
            {# translators: 1: the first product shown, 2: the last, 3: how many there are -#}
            <p class="orillacart-products__count" role="status">{{ total > last or first > 1 ? __('Showing %1$d–%2$d of %3$d')|format(first, last, total) : _n('%d product', '%d products', total)|format(total) }}</p>
        {% endif %}
        {% if show.layouts ?? true %}
            <nav class="orillacart-layouts" aria-label="{{ __('Show products as') }}">
                <a href="{{ layout_urls.grid }}"{{ layout == 'grid' ? ' aria-current="true"' }}>{{ __('Grid') }}</a>
                <a href="{{ layout_urls.list }}"{{ layout == 'list' ? ' aria-current="true"' }}>{{ __('List') }}</a>
            </nav>
        {% endif %}
        {% if layout == 'list' %}
            <ul class="orillacart-products__list">
                {% for product in products %}
                    {% include 'storefront/_product_list_item.html.twig' with {product: product, cart_url: cart_url, heading: 'h2'} only %}
                {% endfor %}
            </ul>
        {% else %}
            <ul class="orillacart-products__grid" style="--orillacart-columns: {{ columns }}">
                {% if card_html is not null %}
                    {% for card in card_html %}
                        <li class="orillacart-product-card orillacart-product-card--designed" data-product="{{ card.id }}">{{ card.html|raw }}</li>
                    {% endfor %}
                {% else %}
                    {% for product in products %}
                        {% include 'storefront/_product_card.html.twig' with {product: product, cart_url: cart_url, heading: 'h2'} only %}
                    {% endfor %}
                {% endif %}
            </ul>
        {% endif %}

        {% if show.pagination ?? true %}
            {% include 'storefront/_pagination.html.twig' with {page: page, pages: pages, page_links: page_links, previous_url: previous_url, next_url: next_url} only %}
        {% endif %}
    {% else %}
        <p class="orillacart-empty">{{ search or filtered ? __('No products match your search.') : __('There are no products here yet.') }}</p>
    {% endif %}
</div>
