{#
 # The frame of every shop email. A theme overrides it with orillacart/emails/layout.html.twig.
 # Blocks: heading, intro, content. lang: the reader's language, such as de-DE. unsubscribe_url: for a reader on
 # the newsletter.
 #}
<!DOCTYPE html>
<html lang="{{ lang|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width">
<title>{{ block('subject') }}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e1e1e;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:8px;">
<tr><td style="padding:24px 32px;border-bottom:1px solid #e4e4e7;font-size:18px;font-weight:600;">{{ site_name }}</td></tr>
<tr><td style="padding:24px 32px;font-size:15px;line-height:1.5;">
<h1 style="margin:0 0 16px;font-size:22px;">{% block heading %}{% endblock %}</h1>
{% block intro %}{% endblock %}
{% block content %}{% include 'emails/_order.html.twig' %}{% endblock %}
{% for text in legal_texts|default([]) %}
<div style="margin-top:32px;padding-top:16px;border-top:1px solid #e4e4e7;font-size:13px;color:#3f3f46;">
<h2 style="margin:0 0 8px;font-size:16px;">{{ text.title }}</h2>
{{ text.html|raw }}
</div>
{% endfor %}
</td></tr>
<tr><td style="padding:16px 32px;border-top:1px solid #e4e4e7;font-size:13px;color:#71717a;"><a href="{{ site_url }}" style="color:#71717a;">{{ site_name }}</a>{% if unsubscribe_url|default(null) %} · <a href="{{ unsubscribe_url }}" style="color:#71717a;">{{ __('Unsubscribe from our newsletter') }}</a>{% endif %}</td></tr>
</table>
</body>
</html>
