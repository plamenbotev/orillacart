{% extends 'emails/layout.html.twig' %}
{# translators: 1: site name, 2: order number -#}
{% block subject %}{{ __('[%1$s] Your order #%2$s waits for your payment')|format(site_name, order.number) }}{% endblock %}
{% block heading %}{{ __('Your order waits for your payment') }}{% endblock %}
{% block intro %}<p>{{ __('We are keeping your order for you. As soon as your payment arrives, we start on it.') }}</p><p>{{ __('Would you rather pay another way?') }} <a href="{{ receipt_url }}#pay" style="color:#2271b1;">{{ __('Pay now') }}</a></p>{% endblock %}
