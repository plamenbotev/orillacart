{% extends 'emails/layout.html.twig' %}
{#
 # To a visitor who asked to hear when a sold-out item is back. product: {name, variation (or null), url}.
 #}
{# translators: 1: site name, 2: product name -#}
{% block subject %}{{ __('[%1$s] %2$s is back in stock')|format(site_name, product.name) }}{% endblock %}
{% block heading %}{{ __('It is back in stock') }}{% endblock %}
{% block intro %}<p>{{ product.variation ? __('%1$s – %2$s is back. Get it before it sells out again.')|format(product.name, product.variation) : __('%s is back. Get it before it sells out again.')|format(product.name) }}</p>{% endblock %}
{% block content %}
<p><a href="{{ product.url }}" style="display:inline-block;padding:10px 18px;background:#2271b1;color:#ffffff;border-radius:4px;text-decoration:none;">{{ __('See it in the shop') }}</a></p>
<p style="color:#71717a;font-size:13px;">{{ __('You asked us to tell you once. We have forgotten your email for it now.') }}</p>
{% endblock %}
