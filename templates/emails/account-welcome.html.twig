{% extends 'emails/layout.html.twig' %}
{#
 # To a customer whose account was just made. first_name, account_url.
 #}
{# translators: %s: site name -#}
{% block subject %}{{ __('[%s] Your account is ready')|format(site_name) }}{% endblock %}
{# translators: %s: the customer's first name -#}
{% block heading %}{{ __('Welcome, %s')|format(first_name) }}{% endblock %}
{% block intro %}<p>{{ __('Your account is ready. In it you follow your orders, download what you bought and keep your addresses for next time.') }}</p>{% endblock %}
{% block content %}
<p><a href="{{ account_url }}" style="display:inline-block;padding:10px 18px;background:#2271b1;color:#ffffff;border-radius:4px;text-decoration:none;">{{ __('Go to your account') }}</a></p>
{% endblock %}
