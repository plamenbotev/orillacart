{% extends 'emails/layout.html.twig' %}
{#
 # To whoever signed up for the newsletter, when the shop confirms new sign-ups: the link that confirms it.
 # link. Anyone can type any address: what they typed as a name is not written in it.
 #}
{# translators: %s: site name -#}
{% block subject %}{{ __('[%s] Confirm your newsletter sign-up')|format(site_name) }}{% endblock %}
{% block heading %}{{ __('Confirm your sign-up') }}{% endblock %}
{% block intro %}<p>{{ __('Someone, we hope you, signed this address up for our newsletter. Confirm it, and the newsletter comes to you.') }}</p>{% endblock %}
{% block content %}
<p><a href="{{ link }}" style="display:inline-block;padding:10px 18px;background:#2271b1;color:#ffffff;border-radius:4px;text-decoration:none;">{{ __('Confirm my sign-up') }}</a></p>
<p style="color:#71717a;font-size:13px;">{{ __('If you did not sign up, ignore this email: you will not hear from us.') }}</p>
{% endblock %}
