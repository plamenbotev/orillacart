{% extends 'emails/layout.html.twig' %}
{#
 # The acknowledgement of a withdrawal. number: the order's; name; items: [{name, quantity}]; declared_at: ISO
 # 8601; confirmation_email.
 #}
{# translators: 1: site name, 2: order number -#}
{% block subject %}{{ __('[%1$s] We received your withdrawal from order #%2$s')|format(site_name, number) }}{% endblock %}
{% block heading %}{{ __('We received your withdrawal') }}{% endblock %}
{% block intro %}<p>{{ __('This confirms the withdrawal you sent us. Keep it: it says what you declared and when.') }}</p>{% endblock %}
{% block content %}
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14px;">
<tr><td style="padding:4px 0;color:#71717a;">{{ __('Order') }}</td><td style="padding:4px 0;">#{{ number }}</td></tr>
<tr><td style="padding:4px 0;color:#71717a;">{{ __('Declared by') }}</td><td style="padding:4px 0;">{{ name }}</td></tr>
<tr><td style="padding:4px 0;color:#71717a;">{{ __('Sent on') }}</td><td style="padding:4px 0;">{{ declared_at|date('Y-m-d H:i:s T') }}</td></tr>
<tr><td style="padding:4px 0;color:#71717a;">{{ __('Confirmation to') }}</td><td style="padding:4px 0;">{{ confirmation_email }}</td></tr>
</table>
<p style="margin-top:16px;">{{ __('You withdraw from the purchase of:') }}</p>
<ul>{% for item in items %}<li>{{ item.quantity }} × {{ item.name }}</li>{% endfor %}</ul>
<p>{{ __('We refund you within 14 days of today, once the goods are back with us or you show they are on their way. Send them back within 14 days.') }}</p>
{% endblock %}
