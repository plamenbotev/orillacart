{% extends 'emails/layout.html.twig' %}
{% block subject %}{% if refund and not refund.full %}{{ __('[%s] We refunded part of your order #%s')|format(site_name, order.number) }}{% else %}{{ __('[%s] Your order #%s was refunded')|format(site_name, order.number) }}{% endif %}{% endblock %}
{% block heading %}{% if refund and not refund.full %}{{ __('Part of your order was refunded') }}{% else %}{{ __('Your order was refunded') }}{% endif %}{% endblock %}
{% block intro %}
{% if refund %}
<p>{{ __('We refunded %s to you.')|format(refund.amount|money(order.currency)) }}</p>
{% if refund.lines %}<ul style="margin:8px 0 0;padding-left:20px;">{% for line in refund.lines %}<li>{{ line.name }} × {{ line.quantity }}</li>{% endfor %}</ul>{% endif %}
{% else %}
<p>{{ __('We have refunded your order.') }}</p>
{% endif %}
{% endblock %}
