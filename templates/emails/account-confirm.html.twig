{% extends 'emails/layout.html.twig' %}
{#
 # To a visitor who asked for an account, or a customer the shop invited (invited): the link that makes it.
 # first_name, link, until (ISO 8601), guest_orders: whether the account takes the orders placed with the email
 # before. Anyone can ask for an account for any address: what they typed as a name is not written in it.
 #}
{# translators: %s: site name -#}
{% block subject %}{{ __('[%s] Make your account')|format(site_name) }}{% endblock %}
{% block heading %}{{ __('Make your account') }}{% endblock %}
{% block intro %}{% if invited ?? false %}<p>{{ __('The shop invites you to make an account with it.') }}</p>{% endif %}<p>{{ (guest_orders ?? true) ? __('Choose your password to make your account. The orders you placed with this email come with it.') : __('Choose your password to make your account.') }}</p>{% endblock %}
{% block content %}
<p><a href="{{ link }}" style="display:inline-block;padding:10px 18px;background:#2271b1;color:#ffffff;border-radius:4px;text-decoration:none;">{{ __('Choose your password') }}</a></p>
{# translators: %s: date and time -#}
<p style="color:#71717a;font-size:13px;">{{ (invited ?? false) ? __('The link works until %s. If you do not want an account, ignore this email.')|format(until|shop_date) : __('The link works until %s. If you did not ask for an account, ignore this email.')|format(until|shop_date) }}</p>
{% endblock %}
