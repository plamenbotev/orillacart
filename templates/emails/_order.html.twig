{# The order: lines, totals, payment and addresses. #}
{# translators: %s: order number -#}
<h2 style="font-size:17px;margin:24px 0 8px;">{{ __('Order #%s')|format(order.number) }}</h2>
<table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
{% for line in order.lines %}
<tr style="border-bottom:1px solid #e4e4e7;">
{# translators: %d: how many of the item -#}
<td>{{ line.name }}{% if line.given_by %}<br><small>{{ line.given_by.description ? __('Free with %s')|format(line.given_by.description) : __('Free gift') }}</small>{% endif %}{% for option in line.options %}<br><small>{{ option.attribute }}: {{ option.option }}</small>{% endfor %}{% for answer in line.personalisation|default([]) %}{% if answer.answer != '' %}<br><small>{{ answer.label }}: {{ answer.answer }}</small>{% endif %}{% endfor %}{% if line.backordered > 0 and (line.backorder_shown or for_shop) %}<br><small>{{ __('%d on backorder')|format(line.backordered) }}</small>{% endif %}{% if line.contents %}<br><small>{{ __('Holds') }}: {% for item in line.contents %}{{ item.quantity }} × {{ item.name }}{{ not loop.last ? ', ' }}{% endfor %}</small>{% endif %}{% if line.refunded_quantity > 0 %}<br><small>{{ __('%d refunded')|format(line.refunded_quantity) }}</small>{% endif %}</td>
<td style="text-align:right;white-space:nowrap;">× {{ line.quantity }}</td>
<td style="text-align:right;white-space:nowrap;">{{ line.total|money(order.currency) }}</td>
</tr>
{% endfor %}
<tr><td colspan="2">{{ __('Subtotal') }}</td><td style="text-align:right;">{{ order.subtotal|money(order.currency) }}</td></tr>
{% for discount in order.discounts %}<tr><td colspan="2">{{ discount.automatic ? discount.description : __('Coupon %s')|format(discount.code) }}</td><td style="text-align:right;">{{ discount.free_shipping ? __('Free shipping') : '−' ~ discount.amount|money(order.currency) }}</td></tr>{% endfor %}
{% if order.shipping %}<tr><td colspan="2">{{ __('Shipping') }}: {{ order.shipping }}</td><td style="text-align:right;">{{ order.shipping_total|money(order.currency) }}</td></tr>{% endif %}
{% for fee in order.fees %}<tr><td colspan="2">{{ fee.label }}</td><td style="text-align:right;">{{ fee.amount|money(order.currency) }}</td></tr>{% endfor %}
{% if not order.prices_include_tax %}{% for tax in order.taxes %}<tr><td colspan="2">{{ tax.name }} ({{ tax.percent }} %)</td><td style="text-align:right;">{{ tax.amount|money(order.currency) }}</td></tr>{% endfor %}{% endif %}
<tr style="font-weight:600;"><td colspan="2">{{ __('Total') }}</td><td style="text-align:right;">{{ order.total|money(order.currency) }}</td></tr>
{% for card in order.gift_cards %}<tr><td colspan="2">{{ card.label }}</td><td style="text-align:right;">−{{ card.amount|money(order.currency) }}</td></tr>{% endfor %}
{% if order.gift_cards %}<tr><td colspan="2">{{ __('To pay') }}</td><td style="text-align:right;">{{ order.amount_due|money(order.currency) }}</td></tr>{% endif %}
{# translators: 1: tax name, 2: its rate -#}
{% if order.prices_include_tax %}{% for tax in order.taxes %}<tr><td colspan="2">{{ __('Including %1$s (%2$s%%)')|format(tax.name, tax.percent) }}</td><td style="text-align:right;">{{ tax.amount|money(order.currency) }}</td></tr>{% endfor %}{% endif %}
{% if order.refunded_total > 0 %}<tr><td colspan="2">{{ __('Refunded') }}</td><td style="text-align:right;">−{{ order.refunded_total|money(order.currency) }}</td></tr>{% endif %}
</table>
{# translators: 1: shipment number, 2: carrier name -#}
{% for shipment in shipments ?? [] %}<p style="margin:16px 0 0;">{{ __('Shipment %1$s with %2$s')|format(shipment.number, shipment.carrier) }}{% if shipment.tracking_url %}: <a href="{{ shipment.tracking_url }}" style="color:#2271b1;">{{ __('follow it') }}</a>{% endif %}{% if (shipments ?? [])|length > 1 %}<br><small>{% for item in shipment.items %}{{ item.quantity }} × {{ item.name }}{{ not loop.last ? ', ' }}{% endfor %}</small>{% endif %}{% if shipment.parcels|length > 1 %}<br><small>{{ __('Parcels:') }} {% for parcel in shipment.parcels %}{% if parcel.tracking_url %}<a href="{{ parcel.tracking_url }}" style="color:#2271b1;">{{ parcel.number }}</a>{% else %}{{ parcel.number }}{% endif %}{{ not loop.last ? ', ' }}{% endfor %}</small>{% endif %}</p>{% endfor %}
{% if order.delivery_date %}<p style="margin:16px 0 0;">{{ __('Delivery') }}: {{ order.delivery_date|shop_day }}{% if order.delivery_slot %}, {{ order.delivery_slot }}{% endif %}</p>{% endif %}
{% if order.pickup_point %}<p style="margin:16px 0 0;">{{ __('Pickup point') }}: {{ order.pickup_point }}</p>{% endif %}
{% if order.payment_name %}<p style="margin:16px 0 0;">{{ __('Payment') }}: {{ order.payment_name }}</p>{% endif %}
{% if order.vat_number %}<p style="margin:8px 0 0;">{{ tax_number_label(order.billing.country) }}: {{ order.vat_number }}{% if order.reverse_charge %} ({{ __('reverse charge: no VAT') }}){% endif %}</p>{% endif %}
{% if order.import_scheme and not order.import_number %}<p style="margin:8px 0 0;">{{ __('Import VAT and duties may be due on delivery.') }}</p>{% endif %}
{% if order.tax_exemption %}<p style="margin:8px 0 0;">{# translators: %s: the customer's exemption certificate's number -#}{{ __('Sold without tax under exemption certificate %s')|format(order.tax_exemption.certificate) }}</p>{% endif %}
{% if order.payment_note and order.status == 'on_hold' %}<p style="margin:8px 0 0;white-space:pre-line;">{{ order.payment_note }}</p>{% endif %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:24px;font-size:14px;"><tr>
<td valign="top" style="padding-right:16px;"><strong>{{ __('Billing address') }}</strong>{% include 'emails/_address.html.twig' with {address: order.billing} %}<br>{{ order.email }}</td>
{% if order.shipping_address %}<td valign="top"><strong>{{ __('Shipping address') }}</strong>{% include 'emails/_address.html.twig' with {address: order.shipping_address} %}</td>{% endif %}
</tr></table>
{% if order.fields %}<table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:16px;font-size:14px;">{% for field in order.fields %}<tr><td valign="top" style="padding-right:16px;"><strong>{{ field.label }}</strong></td><td>{{ field.answer|nl2br }}</td></tr>{% endfor %}</table>{% endif %}
{{ slot('email_after_order', order.number, for_shop) }}
{# translators: %s: the invoice or credit note number -#}
{% if not for_shop %}<p style="margin:24px 0 0;"><a href="{{ receipt_url }}" style="color:#2271b1;">{{ __('See your order online') }}</a>{% for invoice in invoices ?? [] %} · <a href="{{ invoice.url }}" style="color:#2271b1;">{{ (invoice.kind == 'credit_note' ? __('Credit note %s') : __('Invoice %s'))|format(invoice.number) }}</a>{% endfor %}</p>{% endif %}
