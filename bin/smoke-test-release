#!/usr/bin/env bash
#
# Installs the release zip on a clean WordPress (PHP 8.4, MySQL 8.4) in throwaway containers and
# checks the whole lifecycle: activate, CLI, upgrade on an admin request, uninstall.
#
#   bin/smoke-test-release [dist/orillacart-<version>.zip]
#
set -euo pipefail
# Checks read with grep -q from a here-string, not a pipe: grep -q stops at the first match, and under pipefail
# the writer's SIGPIPE would fail a check that passed.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ZIP="${1:-$(ls -t "$ROOT"/dist/orillacart-*.zip | head -1)}"
RUN="orillacart-smoke-$$"
NET="$RUN-net"
DB="$RUN-db"
WP="$RUN-wp"

cleanup() { docker rm -f "$WP" "$DB" > /dev/null 2>&1 || true; docker network rm "$NET" > /dev/null 2>&1 || true; }
trap cleanup EXIT

fail() {
    echo "FAIL: $1" >&2
    # The containers go when the script ends: show what WordPress logged first.
    docker exec "$WP" tail -n 40 /var/www/html/wp-content/debug.log >&2 2> /dev/null || true
    exit 1
}
wp() { docker exec "$WP" wp --allow-root --path=/var/www/html "$@"; }
plugin_tables() { docker exec "$DB" mysql -uwp -pwp wordpress -N -e "SHOW TABLES LIKE 'wp\_orillacart\_%'" 2> /dev/null; }

echo "==> Containers"
docker network create "$NET" > /dev/null
docker run -d --name "$DB" --network "$NET" -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=wordpress \
    -e MYSQL_USER=wp -e MYSQL_PASSWORD=wp mysql:8.4 > /dev/null
docker run -d --name "$WP" --network "$NET" -e WORDPRESS_DB_HOST="$DB" -e WORDPRESS_DB_USER=wp \
    -e WORDPRESS_DB_PASSWORD=wp -e WORDPRESS_DB_NAME=wordpress wordpress:php8.4-apache > /dev/null
for _ in $(seq 1 60); do
    # Over TCP: the temporary server MySQL runs while initialising answers only on its socket.
    docker exec "$DB" mysqladmin ping -h 127.0.0.1 -uroot -proot --silent > /dev/null 2>&1 && break
    sleep 2
done
docker exec "$WP" bash -c 'curl -fsSL -o /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && chmod +x /usr/local/bin/wp'
for _ in $(seq 1 30); do docker exec "$WP" test -f /var/www/html/wp-config.php && break; sleep 1; done
wp config set WP_DEBUG true --raw > /dev/null
wp config set WP_DEBUG_LOG true --raw > /dev/null
wp config set WP_DEBUG_DISPLAY false --raw > /dev/null
# The container has no mail server: keep each mail's recipient and subject in a file instead.
docker exec -i "$WP" bash -c 'mkdir -p /var/www/html/wp-content/mu-plugins && cat > /var/www/html/wp-content/mu-plugins/catch-mail.php' <<'PHP'
<?php
add_filter('pre_wp_mail', static function ($short, array $mail) {
    file_put_contents(WP_CONTENT_DIR . '/mail.log', implode(',', (array) $mail['to']) . ': ' . $mail['subject'] . "\n", FILE_APPEND);

    return true;
}, 10, 2);
PHP
wp config set WP_ENVIRONMENT_TYPE local > /dev/null  # application passwords over plain HTTP
wp core install --url=http://localhost --title=Smoke --admin_user=admin --admin_password=admin \
    --admin_email=admin@example.com --skip-email > /dev/null
echo "    WordPress $(wp core version), $(docker exec "$WP" php -r 'echo PHP_VERSION;')"

echo "==> Install and activate $(basename "$ZIP")"
docker cp "$ZIP" "$WP:/tmp/orillacart.zip"
wp plugin install /tmp/orillacart.zip --activate > /dev/null
[ "$(wp plugin get orillacart --field=status)" = "active" ] || fail "plugin is not active"
plugin_tables | grep -qx 'wp_orillacart_migrations' || fail "activation did not create the migrations table"
wp orillacart migrate | grep -q 'up to date' || fail "wp orillacart migrate"

echo "==> Translations from the plugin's languages folder"
LANGS=/var/www/html/wp-content/plugins/orillacart/languages
docker exec "$WP" test -f "$LANGS/orillacart.pot" || fail "the release has no languages/orillacart.pot"
docker exec -i "$WP" bash -c "cat > $LANGS/orillacart-bg_BG.po" <<'PO'
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: bg_BG\n"

#: src/Catalog/Infrastructure/WordPress/Content/ProductPostType.php
msgid "Products"
msgstr "Продукти"

#: build/admin/settings.js:1
msgid "Save settings"
msgstr "Запази настройките"
PO
wp i18n make-mo "$LANGS/orillacart-bg_BG.po" > /dev/null
wp i18n make-json "$LANGS/orillacart-bg_BG.po" --no-purge > /dev/null
# WordPress takes only an installed language as the site's; a filter sets one without installing it.
docker exec "$WP" bash -c "echo '<?php add_filter(\"locale\", static fn() => \"bg_BG\");' > /var/www/html/wp-content/mu-plugins/locale.php"
[ "$(wp eval 'echo __("Products", "orillacart");')" = 'Продукти' ] || fail "the PHP translations in languages/ were not loaded"
# As AdminScripts registers the settings screen's script: the JSON is named after the script's path in the plugin.
wp eval 'wp_register_script("orillacart-settings", plugins_url("build/admin/settings.js", WP_PLUGIN_DIR . "/orillacart/orillacart.php"));
    $json = json_decode((string) load_script_textdomain("orillacart-settings", "orillacart", WP_PLUGIN_DIR . "/orillacart/languages"), true);
    echo $json["locale_data"]["messages"]["Save settings"][0] ?? "";' \
    | grep -qx 'Запази настройките' || fail "the script translations in languages/ were not found"
docker exec "$WP" bash -c "rm $LANGS/orillacart-bg_BG* /var/www/html/wp-content/mu-plugins/locale.php"

echo "==> REST API over HTTP"
api() { docker exec "$WP" curl -s -o /dev/null -w '%{http_code}' "$@"; }
URL='http://localhost/?rest_route=/orillacart/v1/settings'
docker exec "$WP" test -f /var/www/html/wp-content/plugins/orillacart/build/admin/settings.js || fail "admin script missing"
[ "$(api "$URL")" = 401 ] || fail "a visitor could read the settings"
PASS="$(wp user application-password create admin smoke --porcelain)"
[ "$(api -u "admin:$PASS" "$URL")" = 200 ] || fail "the administrator could not read the settings"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' \
    -d '{"currency":"USD","fewer_decimals":null,"weight_unit":"lb","dimension_unit":"in"}' "$URL")" = 200 ] \
    || fail "the administrator could not save the settings"
[ "$(wp option pluck orillacart_settings currency)" = USD ] || fail "the settings were not stored"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' -d '{"currency":"usd"}' "$URL")" = 422 ] \
    || fail "invalid settings were not refused"
# A cookie session (no application password) must send a nonce.
status="$(wp eval --user=admin '
    $request = new WP_REST_Request("PUT", "/orillacart/v1/settings");
    $request->set_header("Content-Type", "application/json");
    $request->set_body("{\"currency\":\"GBP\",\"fewer_decimals\":null,\"weight_unit\":\"lb\",\"dimension_unit\":\"in\"}");
    echo rest_do_request($request)->get_status();
')"
[ "$status" = 403 ] || fail "a save without a nonce answered $status"

echo "==> Geography and tax"
[ "$(docker exec "$DB" mysql -uwp -pwp wordpress -N -e 'SELECT COUNT(*) FROM wp_orillacart_countries' 2> /dev/null)" = 249 ] \
    || fail "the countries were not seeded"
[ "$(api 'http://localhost/?rest_route=/orillacart/v1/countries/US/states')" = 200 ] || fail "a visitor could not list states"
TAX='http://localhost/?rest_route=/orillacart/v1/tax'
group="$(docker exec "$WP" curl -s -u "admin:$PASS" -X POST -H 'Content-Type: application/json' -d '{"name":"Standard"}' \
    "$TAX/groups" | sed -n 's/.*"id":\([0-9]*\).*/\1/p')"
[ -n "$group" ] || fail "the administrator could not create a tax group"
[ "$(api -u "admin:$PASS" "$TAX/groups")" = 200 ] || fail "the administrator could not list the tax groups"
[ "$(api -u "admin:$PASS" -X POST -H 'Content-Type: application/json' \
    -d '{"country":"US","state":"CA","percent":"7.25","name":"California"}' "$TAX/groups/$group/rates")" = 201 ] \
    || fail "the administrator could not add a tax rate"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' \
    -d "{\"basis\":\"shipping_address\",\"default_group_id\":$group}" "$TAX/settings")" = 200 ] \
    || fail "the administrator could not save the tax settings"
taxes="$(wp eval '
    $kernel = new OrillaCart\Platform\Kernel(new OrillaCart\Platform\PluginContext(WP_PLUGIN_DIR . "/orillacart/orillacart.php", ORILLACART_VERSION));
    echo $kernel->container()->get(OrillaCart\Tax\Application\TaxCalculator::class)
        ->taxes(new OrillaCart\Tax\Application\Dto\TaxQuery(shipping: new OrillaCart\Tax\Application\Dto\TaxAddress("US", "CA")))->total;
')"
[ "$taxes" = 7.25 ] || fail "the tax calculator answered $taxes for California"

echo "==> Catalog and stock"
API='http://localhost/?rest_route=/orillacart/v1'
product="$(wp post create --post_type=orillacart_product --post_title=Mug --post_status=publish --porcelain)"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' \
    -d '{"price":"9.5","sku":"MUG","attributes":[{"name":"Colour","options":[{"name":"Gold","adjustment":"2"}]}]}' \
    "$API/products/$product")" = 200 ] || fail "the administrator could not save a product"
stockroom="$(docker exec "$WP" curl -s -u "admin:$PASS" -X POST -H 'Content-Type: application/json' -d '{"name":"Sofia"}' \
    "$API/stockrooms" | sed -n 's/.*"id":\([0-9]*\).*/\1/p')"
[ -n "$stockroom" ] || fail "the administrator could not add a stockroom"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' \
    -d "{\"levels\":[{\"stockroom_id\":$stockroom,\"quantity\":3}]}" "$API/stock/product/$product")" = 200 ] \
    || fail "the administrator could not set stock"
quote="$(wp eval "
    \$kernel = new OrillaCart\Platform\Kernel(new OrillaCart\Platform\PluginContext(WP_PLUGIN_DIR . '/orillacart/orillacart.php', ORILLACART_VERSION));
    \$quote = \$kernel->container()->get(OrillaCart\Catalog\Application\ProductQuotes::class)
        ->quote(new OrillaCart\Catalog\Application\Dto\QuoteRequest($product));
    echo \$quote->unitPrice, ' ', \$quote->available;
")"
[ "$quote" = '9.5 3' ] || fail "the product was quoted as '$quote'"
[ "$(api -L "$(wp eval "echo get_permalink($product);")")" = 200 ] \
    || fail "the product page does not open"

echo "==> Cart and checkout"
rate="$(docker exec "$WP" curl -s -u "admin:$PASS" -X POST -H 'Content-Type: application/json' \
    -d '{"name":"Courier","rates":[{"name":"Anywhere","price":"5"}]}' "$API/carriers" | sed -n 's/.*"rates":\[{"id":\([0-9]*\).*/\1/p')"
[ -n "$rate" ] || fail "the administrator could not add a carrier"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' \
    -d '{"name":"Cash on delivery","active":true}' "$API/payment-methods/cash_on_delivery")" = 200 ] \
    || fail "the administrator could not turn on cash on delivery"
# A visitor: the cart lives in the database, the browser keeps its token in a cookie.
nonce="$(wp eval 'wp_set_current_user(0); echo wp_create_nonce("wp_rest");')"
visitor() { docker exec "$WP" curl -s -b /tmp/cart -c /tmp/cart -H "X-WP-Nonce: $nonce" -H 'Content-Type: application/json' "$@"; }
visitor -X POST -d "{\"product_id\":$product,\"quantity\":2}" "$API/cart/items" | grep -q '"items":2' \
    || fail "a visitor could not add to the cart"
docker exec "$WP" grep -q 'orillacart_cart' /tmp/cart || fail "the cart cookie was not set"
placed="$(visitor -X POST -d "{\"email\":\"ada@example.com\",\"billing\":{\"first_name\":\"Ada\",\"last_name\":\"Lovelace\",\"street\":\"1 Main St\",\"city\":\"Sofia\",\"postcode\":\"1000\",\"country\":\"BG\",\"phone\":\"+359 2 000 0000\"},\"shipping_option\":\"rate:$rate\",\"payment\":\"cash_on_delivery\"}" "$API/checkout")"
grep -q '"status":"on_hold"' <<< "$placed" || fail "the order was not placed: $placed"
# The receipt link is signed: the order number, the day, and a signature, in the receipt address.
key="$(echo "$placed" | sed -n 's/.*orillacart_order=\([0-9]*-[0-9]*-[a-f0-9]*\).*/\1/p')"
[ "$(api "$API/receipts/$key")" = 200 ] || fail "the receipt does not open"
[ "$(wp eval "
    \$kernel = new OrillaCart\Platform\Kernel(new OrillaCart\Platform\PluginContext(WP_PLUGIN_DIR . '/orillacart/orillacart.php', ORILLACART_VERSION));
    echo \$kernel->container()->get(OrillaCart\Inventory\Application\StockService::class)
        ->stock(OrillaCart\Inventory\Application\Dto\StockItemRef::product($product))->available;
")" = 1 ] || fail "the order did not take its stock"
for hook in orillacart_cancel_abandoned_orders orillacart_forget_abandoned_carts; do
    wp cron event list --fields=hook --format=csv | grep -qx "$hook" || fail "$hook is not scheduled"
done
wp cron event run orillacart_cancel_abandoned_orders orillacart_forget_abandoned_carts > /dev/null || fail "the scheduled tasks failed"

# Emails are jobs; this Apache answers before nothing, so cron or a worker sends them.
wp orillacart jobs work > /dev/null || fail "the jobs did not run"
docker exec "$WP" grep -q 'ada@example.com: .* We received your order' /var/www/html/wp-content/mail.log \
    || fail "the customer was not emailed about the order"

# Invoices go to customers as PDFs, printed by the bundled dompdf under the plugin's prefix, its fonts included.
pdf="$(wp eval '
    $options = new OrillaCart\Vendor\Dompdf\Options();
    $options->setDefaultFont("DejaVu Sans")->setFontCache(get_temp_dir())->setTempDir(get_temp_dir());
    $pdf = new OrillaCart\Vendor\Dompdf\Dompdf($options);
    $pdf->loadHtml("<p>Фактура № 1</p><table><tr><td>Лампа</td></tr></table>", "UTF-8");
    $pdf->render();
    $out = (string) $pdf->output();
    echo substr($out, 0, 5), str_contains($out, "DejaVuSans") ? " DejaVu" : "";
')"
[ "$pdf" = '%PDF- DejaVu' ] || fail "the bundled dompdf printed '$pdf'"

echo "==> Orders, accounts and downloads"
[ "$(api -u "admin:$PASS" "$API/orders&status=on_hold")" = 200 ] || fail "the administrator could not list orders"
number="$(echo "$placed" | sed -n 's/.*"number":\([0-9]*\).*/\1/p')"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' -d '{"status":"cancelled"}' "$API/orders/$number/status")" = 200 ] \
    || fail "the administrator could not cancel the order"
[ "$(wp eval "
    \$kernel = new OrillaCart\Platform\Kernel(new OrillaCart\Platform\PluginContext(WP_PLUGIN_DIR . '/orillacart/orillacart.php', ORILLACART_VERSION));
    echo \$kernel->container()->get(OrillaCart\Inventory\Application\StockService::class)
        ->stock(OrillaCart\Inventory\Application\Dto\StockItemRef::product($product))->available;
")" = 3 ] || fail "cancelling did not put the stock back"
docker exec "$WP" bash -c 'printf "%%PDF guide" > /tmp/guide.pdf'
upload="$(docker exec "$WP" curl -s -u "admin:$PASS" -F 'file=@/tmp/guide.pdf;type=application/pdf' "$API/products/$product/downloads")"
grep -q '"name":"guide.pdf"' <<< "$upload" || fail "the administrator could not upload a download: $upload"
storage="$(docker exec "$WP" curl -s -u "admin:$PASS" "$API/download-storage&fresh=1")"
grep -q '"reachable":true' <<< "$storage" && fail "the web server hands out download files by itself: $storage"
[ "$(wp post list --post_type=attachment --format=count)" = 0 ] || fail "a download became a media library item"

echo "==> Storefront"
page_of() { wp option pluck orillacart_shop_pages "$1"; }
for part in shop cart checkout account; do
    [ "$(wp post get "$(page_of "$part")" --field=post_status 2> /dev/null)" = publish ] || fail "activation made no $part page"
done
# A page's address, with a query argument when one is given.
link_to() {
    if [ $# -gt 1 ]; then wp eval "echo add_query_arg('$2', '$3', get_permalink($1));"; else wp eval "echo get_permalink($1);"; fi
}
html() { docker exec "$WP" curl -s "$(link_to "$@")"; }
for asset in build/storefront/storefront.js build/storefront/storefront.css build/admin/blocks.js build/admin/dataviews.js; do
    docker exec "$WP" test -f "/var/www/html/wp-content/plugins/orillacart/$asset" || fail "$asset missing"
done
shop_page="$(html "$(page_of shop)")"
grep -q 'class="orillacart-product-card"' <<< "$shop_page" || fail "the shop page lists no products"
grep -q 'build/storefront/storefront.css' <<< "$shop_page" \
    || { tail -n 30 <<< "$shop_page" >&2; fail "the shop page does not load the storefront styles"; }
grep -q '"nonce":null' <<< "$shop_page" || fail "a visitor's page carries a nonce a page cache would keep"
product_page="$(html "$product")"
grep -q 'data-orillacart-add-to-cart' <<< "$product_page" \
    || fail "the product page has no way to buy: $(echo "$product_page" | grep -o 'orillacart-[a-z-]*' | sort -u | tr '\n' ' ')"
receipt_page="$(html "$(page_of checkout)" orillacart_order "$key")"
grep -q "<strong>#$number</strong>" <<< "$receipt_page" || fail "the receipt page does not show the order"
headers() { docker exec "$WP" curl -s -D - -o /dev/null "$(link_to "$@")"; }
for part in cart checkout account; do
    grep -qi '^cache-control:.*no-store' <<< "$(headers "$(page_of "$part")")" || fail "the $part page may be cached"
done
for secret in "$(page_of checkout) orillacart_order $key" "$(page_of account) orillacart_account token"; do
    # shellcheck disable=SC2086 # the page, the query and its value
    link_headers="$(headers $secret)"
    grep -qi '^cache-control:.*no-store' <<< "$link_headers" || fail "a page opened with ${secret#* } may be cached"
    grep -qi '^referrer-policy: no-referrer' <<< "$link_headers" || fail "a page opened with ${secret#* } sends its address on"
done

echo "==> Upgrade on an admin request"
wp option update orillacart_version 0.0.1 > /dev/null
# A site whose files are newer than its database: here, one without any of the plugin's tables.
# GROUP_CONCAT stops at 1024 bytes unless told otherwise; the plugin has more tables than fit.
docker exec "$DB" mysql -uwp -pwp wordpress -N -e "SET SESSION group_concat_max_len = 65535; SELECT CONCAT('DROP TABLE ', GROUP_CONCAT(table_name), ';') FROM information_schema.tables
    WHERE table_schema = 'wordpress' AND table_name LIKE 'wp\\_orillacart\\_%'" 2> /dev/null \
    | { echo 'SET FOREIGN_KEY_CHECKS = 0;'; cat; } | docker exec -i "$DB" mysql -uwp -pwp wordpress 2> /dev/null
[ -z "$(plugin_tables)" ] || fail "could not drop the plugin tables before the upgrade"
docker exec "$WP" bash -c 'cd /var/www/html && php -r "
    define(\"WP_ADMIN\", true);
    require \"wp-load.php\";
    wp_set_current_user(1);
    do_action(\"admin_init\");
"'
[ "$(wp option get orillacart_version)" != "0.0.1" ] || fail "admin_init did not run the upgrade"
plugin_tables | grep -qx 'wp_orillacart_migrations' || fail "the upgrade did not restore the schema"
plugin_tables | grep -qx 'wp_orillacart_countries' || fail "the upgrade did not create the countries table"

echo "==> Uninstall"
# Deleting the plugin keeps the shop's data unless its settings ask for it to go.
remove_all_data() {
    wp "$@" eval '$s = get_option("orillacart_settings");
        $s = is_array($s) ? $s : ["currency" => "EUR", "weight_unit" => "kg", "dimension_unit" => "cm"];
        $s["remove_data_on_uninstall"] = true;
        update_option("orillacart_settings", $s);'
}
remove_all_data
before="$(docker exec "$DB" mysql -uwp -pwp wordpress -N -e 'SHOW TABLES' 2> /dev/null | grep -vc orillacart)"
wp plugin uninstall orillacart --deactivate > /dev/null
[ -z "$(plugin_tables)" ] || fail "plugin tables left after uninstall"
after="$(docker exec "$DB" mysql -uwp -pwp wordpress -N -e 'SHOW TABLES' 2> /dev/null | grep -vc orillacart)"
[ "$before" = "$after" ] || fail "uninstall touched WordPress tables ($before before, $after after)"
wp option get orillacart_version > /dev/null 2>&1 && fail "version option left after uninstall"
wp option get orillacart_settings > /dev/null 2>&1 && fail "settings left after uninstall"
wp option get orillacart_tax_settings > /dev/null 2>&1 && fail "tax settings left after uninstall"
wp cap list administrator | grep -qx manage_orillacart && fail "capability left after uninstall"
[ "$(docker exec "$DB" mysql -uwp -pwp wordpress -N -e "SELECT COUNT(*) FROM wp_posts WHERE post_type = 'orillacart_product'" 2> /dev/null)" = 0 ] \
    || fail "product posts left after uninstall"
wp cron event list --fields=hook --format=csv | grep -q '^orillacart_' && fail "scheduled tasks left after uninstall"
wp option get orillacart_email_settings > /dev/null 2>&1 && fail "email settings left after uninstall"
docker exec "$WP" bash -c 'ls -d /var/www/orillacart-downloads /var/www/html/wp-content/uploads/orillacart-* 2> /dev/null' && fail "download files left after uninstall"
wp role exists orillacart_customer > /dev/null 2>&1 && fail "customer role left after uninstall"
wp option get orillacart_shop_pages > /dev/null 2>&1 && fail "shop pages option left after uninstall"
[ "$(wp post list --post_type=page --post_status=any --s='orillacart/' --format=count)" = 0 ] || fail "shop pages left after uninstall"

echo "==> Multisite"
# The same install as a network: activating for the network sets up every site, a site added later is set up,
# a deleted site's tables go with it, and uninstalling clears every site.
site_tables() { docker exec "$DB" mysql -uwp -pwp wordpress -N -e "SHOW TABLES LIKE 'wp\_$1orillacart\_%'" 2> /dev/null; }
wp core multisite-convert --title=Network > /dev/null
wp site create --slug=second --porcelain > /dev/null
wp plugin install /tmp/orillacart.zip --activate-network > /dev/null
site_tables '' | grep -qx 'wp_orillacart_migrations' || fail "network activation did not set up the main site"
site_tables '2\_' | grep -qx 'wp_2_orillacart_countries' || fail "network activation did not set up the second site"
[ "$(wp --url=http://localhost/second/ post get "$(wp --url=http://localhost/second/ option pluck orillacart_shop_pages shop)" --field=post_status)" = publish ] \
    || fail "network activation made no shop page on the second site"
third="$(wp site create --slug=third --porcelain)"
site_tables "${third}\\_" | grep -qx "wp_${third}_orillacart_migrations" || fail "a site added to the network was not set up"
wp site delete "$third" --yes > /dev/null
[ -z "$(site_tables "${third}\\_")" ] || fail "a deleted site's tables were left"
wp plugin deactivate orillacart --network > /dev/null
remove_all_data
remove_all_data --url=http://localhost/second/
wp plugin uninstall orillacart > /dev/null
[ -z "$(site_tables '')$(site_tables '2\_')" ] || fail "plugin tables left after uninstalling from the network"
wp --url=http://localhost/second/ option get orillacart_version > /dev/null 2>&1 && fail "the second site's options left after uninstall"

echo "==> Debug log"
if docker exec "$WP" test -s /var/www/html/wp-content/debug.log; then
    docker exec "$WP" cat /var/www/html/wp-content/debug.log >&2
    fail "PHP notices or errors were logged"
fi

echo "Release smoke test passed"
