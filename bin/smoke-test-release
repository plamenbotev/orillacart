#!/usr/bin/env bash
#
# Installs the release zip on a clean WordPress (PHP 8.4, MySQL 8.4) in throwaway containers and
# checks the whole lifecycle: activate, CLI, upgrade on an admin request, uninstall.
#
#   bin/smoke-test-release [dist/orillacart-<version>.zip]
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ZIP="${1:-$(ls -t "$ROOT"/dist/orillacart-*.zip | head -1)}"
RUN="orillacart-smoke-$$"
NET="$RUN-net"
DB="$RUN-db"
WP="$RUN-wp"

cleanup() { docker rm -f "$WP" "$DB" > /dev/null 2>&1 || true; docker network rm "$NET" > /dev/null 2>&1 || true; }
trap cleanup EXIT

fail() { echo "FAIL: $1" >&2; exit 1; }
wp() { docker exec "$WP" wp --allow-root --path=/var/www/html "$@"; }
plugin_tables() { docker exec "$DB" mysql -uwp -pwp wordpress -N -e "SHOW TABLES LIKE 'wp\_orillacart\_%'" 2> /dev/null; }

echo "==> Containers"
docker network create "$NET" > /dev/null
docker run -d --name "$DB" --network "$NET" -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=wordpress \
    -e MYSQL_USER=wp -e MYSQL_PASSWORD=wp mysql:8.4 > /dev/null
docker run -d --name "$WP" --network "$NET" -e WORDPRESS_DB_HOST="$DB" -e WORDPRESS_DB_USER=wp \
    -e WORDPRESS_DB_PASSWORD=wp -e WORDPRESS_DB_NAME=wordpress wordpress:php8.4-apache > /dev/null
for _ in $(seq 1 60); do
    # Over TCP: the temporary server MySQL runs while initialising answers only on its socket.
    docker exec "$DB" mysqladmin ping -h 127.0.0.1 -uroot -proot --silent > /dev/null 2>&1 && break
    sleep 2
done
docker exec "$WP" bash -c 'curl -fsSL -o /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && chmod +x /usr/local/bin/wp'
for _ in $(seq 1 30); do docker exec "$WP" test -f /var/www/html/wp-config.php && break; sleep 1; done
wp config set WP_DEBUG true --raw > /dev/null
wp config set WP_DEBUG_LOG true --raw > /dev/null
wp config set WP_DEBUG_DISPLAY false --raw > /dev/null
wp config set WP_ENVIRONMENT_TYPE local > /dev/null  # application passwords over plain HTTP
wp core install --url=http://localhost --title=Smoke --admin_user=admin --admin_password=admin \
    --admin_email=admin@example.com --skip-email > /dev/null
echo "    WordPress $(wp core version), $(docker exec "$WP" php -r 'echo PHP_VERSION;')"

echo "==> Install and activate $(basename "$ZIP")"
docker cp "$ZIP" "$WP:/tmp/orillacart.zip"
wp plugin install /tmp/orillacart.zip --activate > /dev/null
[ "$(wp plugin get orillacart --field=status)" = "active" ] || fail "plugin is not active"
plugin_tables | grep -qx 'wp_orillacart_migrations' || fail "activation did not create the migrations table"
wp orillacart migrate | grep -q 'up to date' || fail "wp orillacart migrate"

echo "==> REST API over HTTP"
api() { docker exec "$WP" curl -s -o /dev/null -w '%{http_code}' "$@"; }
URL='http://localhost/?rest_route=/orillacart/v1/settings'
docker exec "$WP" test -f /var/www/html/wp-content/plugins/orillacart/build/admin/settings.js || fail "admin script missing"
[ "$(api "$URL")" = 401 ] || fail "a visitor could read the settings"
PASS="$(wp user application-password create admin smoke --porcelain)"
[ "$(api -u "admin:$PASS" "$URL")" = 200 ] || fail "the administrator could not read the settings"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' \
    -d '{"currency":"USD","price_decimals":2,"weight_unit":"lb","dimension_unit":"in"}' "$URL")" = 200 ] \
    || fail "the administrator could not save the settings"
[ "$(wp option pluck orillacart_settings currency)" = USD ] || fail "the settings were not stored"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' -d '{"currency":"usd"}' "$URL")" = 422 ] \
    || fail "invalid settings were not refused"
# A cookie session (no application password) must send a nonce.
status="$(wp eval --user=admin '
    $request = new WP_REST_Request("PUT", "/orillacart/v1/settings");
    $request->set_header("Content-Type", "application/json");
    $request->set_body("{\"currency\":\"GBP\",\"price_decimals\":2,\"weight_unit\":\"lb\",\"dimension_unit\":\"in\"}");
    echo rest_do_request($request)->get_status();
')"
[ "$status" = 403 ] || fail "a save without a nonce answered $status"

echo "==> Geography and tax"
[ "$(docker exec "$DB" mysql -uwp -pwp wordpress -N -e 'SELECT COUNT(*) FROM wp_orillacart_countries' 2> /dev/null)" = 249 ] \
    || fail "the countries were not seeded"
[ "$(api 'http://localhost/?rest_route=/orillacart/v1/countries/US/states')" = 200 ] || fail "a visitor could not list states"
TAX='http://localhost/?rest_route=/orillacart/v1/tax'
group="$(docker exec "$WP" curl -s -u "admin:$PASS" -X POST -H 'Content-Type: application/json' -d '{"name":"Standard"}' \
    "$TAX/groups" | sed -n 's/.*"id":\([0-9]*\).*/\1/p')"
[ -n "$group" ] || fail "the administrator could not create a tax group"
[ "$(api -u "admin:$PASS" "$TAX/groups")" = 200 ] || fail "the administrator could not list the tax groups"
[ "$(api -u "admin:$PASS" -X POST -H 'Content-Type: application/json' \
    -d '{"country":"US","state":"CA","percent":"7.25","name":"California"}' "$TAX/groups/$group/rates")" = 201 ] \
    || fail "the administrator could not add a tax rate"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' \
    -d "{\"basis\":\"shipping_address\",\"default_group_id\":$group}" "$TAX/settings")" = 200 ] \
    || fail "the administrator could not save the tax settings"
taxes="$(wp eval '
    $kernel = new OrillaCart\Platform\Kernel(new OrillaCart\Platform\PluginContext(WP_PLUGIN_DIR . "/orillacart/orillacart.php", ORILLACART_VERSION));
    echo $kernel->container()->get(OrillaCart\Tax\Application\TaxCalculator::class)
        ->taxes(new OrillaCart\Tax\Application\Dto\TaxQuery(shipping: new OrillaCart\Tax\Application\Dto\TaxAddress("US", "CA")))->total;
')"
[ "$taxes" = 7.25 ] || fail "the tax calculator answered $taxes for California"

echo "==> Catalog and stock"
API='http://localhost/?rest_route=/orillacart/v1'
product="$(wp post create --post_type=orillacart_product --post_title=Mug --post_status=publish --porcelain)"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' \
    -d '{"price":"9.5","sku":"MUG","attributes":[{"name":"Colour","options":[{"name":"Gold","adjustment":"2"}]}]}' \
    "$API/products/$product")" = 200 ] || fail "the administrator could not save a product"
stockroom="$(docker exec "$WP" curl -s -u "admin:$PASS" -X POST -H 'Content-Type: application/json' -d '{"name":"Sofia"}' \
    "$API/stockrooms" | sed -n 's/.*"id":\([0-9]*\).*/\1/p')"
[ -n "$stockroom" ] || fail "the administrator could not add a stockroom"
[ "$(api -u "admin:$PASS" -X PUT -H 'Content-Type: application/json' \
    -d "{\"levels\":[{\"stockroom_id\":$stockroom,\"quantity\":3}]}" "$API/stock/product/$product")" = 200 ] \
    || fail "the administrator could not set stock"
quote="$(wp eval "
    \$kernel = new OrillaCart\Platform\Kernel(new OrillaCart\Platform\PluginContext(WP_PLUGIN_DIR . '/orillacart/orillacart.php', ORILLACART_VERSION));
    \$quote = \$kernel->container()->get(OrillaCart\Catalog\Application\ProductQuotes::class)
        ->quote(new OrillaCart\Catalog\Application\Dto\QuoteRequest($product));
    echo \$quote->unitPrice, ' ', \$quote->available;
")"
[ "$quote" = '9.5 3' ] || fail "the product was quoted as '$quote'"
[ "$(api -L "$(wp eval "echo get_permalink($product);")")" = 200 ] \
    || fail "the product page does not open"

echo "==> Upgrade on an admin request"
wp option update orillacart_version 0.0.1 > /dev/null
# A site whose files are newer than its database: here, one without any of the plugin's tables.
docker exec "$DB" mysql -uwp -pwp wordpress -N -e "SELECT CONCAT('DROP TABLE ', GROUP_CONCAT(table_name), ';') FROM information_schema.tables
    WHERE table_schema = 'wordpress' AND table_name LIKE 'wp\\_orillacart\\_%'" 2> /dev/null \
    | { echo 'SET FOREIGN_KEY_CHECKS = 0;'; cat; } | docker exec -i "$DB" mysql -uwp -pwp wordpress 2> /dev/null
[ -z "$(plugin_tables)" ] || fail "could not drop the plugin tables before the upgrade"
docker exec "$WP" bash -c 'cd /var/www/html && php -r "
    define(\"WP_ADMIN\", true);
    require \"wp-load.php\";
    wp_set_current_user(1);
    do_action(\"admin_init\");
"'
[ "$(wp option get orillacart_version)" != "0.0.1" ] || fail "admin_init did not run the upgrade"
plugin_tables | grep -qx 'wp_orillacart_migrations' || fail "the upgrade did not restore the schema"
plugin_tables | grep -qx 'wp_orillacart_countries' || fail "the upgrade did not create the countries table"

echo "==> Uninstall"
before="$(docker exec "$DB" mysql -uwp -pwp wordpress -N -e 'SHOW TABLES' 2> /dev/null | grep -vc orillacart)"
wp plugin uninstall orillacart --deactivate > /dev/null
[ -z "$(plugin_tables)" ] || fail "plugin tables left after uninstall"
after="$(docker exec "$DB" mysql -uwp -pwp wordpress -N -e 'SHOW TABLES' 2> /dev/null | grep -vc orillacart)"
[ "$before" = "$after" ] || fail "uninstall touched WordPress tables ($before before, $after after)"
wp option get orillacart_version > /dev/null 2>&1 && fail "version option left after uninstall"
wp option get orillacart_settings > /dev/null 2>&1 && fail "settings left after uninstall"
wp option get orillacart_tax_settings > /dev/null 2>&1 && fail "tax settings left after uninstall"
wp cap list administrator | grep -qx manage_orillacart && fail "capability left after uninstall"
[ "$(docker exec "$DB" mysql -uwp -pwp wordpress -N -e "SELECT COUNT(*) FROM wp_posts WHERE post_type = 'orillacart_product'" 2> /dev/null)" = 0 ] \
    || fail "product posts left after uninstall"

echo "==> Debug log"
if docker exec "$WP" test -s /var/www/html/wp-content/debug.log; then
    docker exec "$WP" cat /var/www/html/wp-content/debug.log >&2
    fail "PHP notices or errors were logged"
fi

echo "Release smoke test passed"
