{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "orillacart/products",
	"title": "Products",
	"category": "widgets",
	"icon": "products",
	"description": "The shop: products with their prices, by category, with search.",
	"keywords": [
		"shop",
		"catalog"
	],
	"textdomain": "orillacart",
	"attributes": {
		"perPage": {
			"type": "integer",
			"default": 12
		},
		"columns": {
			"type": "integer",
			"default": 3
		},
		"layout": {
			"type": "string",
			"enum": [
				"grid",
				"list"
			],
			"default": "grid"
		},
		"category": {
			"type": "string",
			"default": ""
		},
		"tag": {
			"type": "string",
			"default": ""
		},
		"sort": {
			"type": "string",
			"default": "order"
		},
		"featured": {
			"type": "boolean",
			"default": false
		},
		"onSale": {
			"type": "boolean",
			"default": false
		},
		"filters": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "orillacart-blocks",
	"viewScript": "orillacart-storefront",
	"style": "orillacart-storefront"
}
