{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "orillacart/product",
	"title": "Single product",
	"category": "theme",
	"icon": "products",
	"description": "One product anywhere, such as a landing page: the product blocks inside show the product chosen here.",
	"keywords": [
		"shop",
		"product",
		"spotlight"
	],
	"textdomain": "orillacart",
	"attributes": {
		"productId": {
			"type": "integer",
			"default": 0
		}
	},
	"providesContext": {
		"postId": "productId"
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"color": {
			"background": true,
			"text": true
		}
	},
	"editorScript": "orillacart-blocks",
	"viewScript": "orillacart-storefront",
	"style": "orillacart-storefront"
}
