{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "orillacart/product-stock",
	"title": "Product stock",
	"category": "theme",
	"icon": "archive",
	"description": "Whether the product is in stock, and how many, as of the chosen variation.",
	"keywords": [
		"shop",
		"product",
		"stock",
		"availability"
	],
	"textdomain": "orillacart",
	"attributes": {
		"productId": {
			"type": "integer",
			"default": 0
		},
		"preview": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "orillacart-blocks",
	"viewScript": "orillacart-storefront",
	"style": "orillacart-storefront"
}
