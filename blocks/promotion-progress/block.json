{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "orillacart/promotion-progress",
	"title": "Promotion progress",
	"category": "widgets",
	"icon": "megaphone",
	"description": "What the shopper’s cart still needs for the shop’s promotions, nearest first, with a bar, and the promotions it gets already. Shows nothing while there is nothing to tell.",
	"keywords": [
		"shop",
		"promotion",
		"discount",
		"coupon",
		"cart"
	],
	"textdomain": "orillacart",
	"attributes": {
		"showApplied": {
			"type": "boolean",
			"default": true
		},
		"showBars": {
			"type": "boolean",
			"default": true
		},
		"count": {
			"type": "integer",
			"default": 3
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "orillacart-blocks",
	"viewScript": "orillacart-storefront",
	"style": "orillacart-storefront"
}
