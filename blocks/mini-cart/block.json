{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "orillacart/mini-cart",
	"title": "Mini cart",
	"category": "widgets",
	"icon": "cart",
	"description": "The number of items in the cart, with a link or buttons to the cart and the checkout.",
	"textdomain": "orillacart",
	"attributes": {
		"showButtons": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "orillacart-blocks",
	"viewScript": "orillacart-storefront",
	"style": "orillacart-storefront"
}
