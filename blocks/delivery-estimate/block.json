{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "orillacart/delivery-estimate",
	"title": "Delivery estimate",
	"category": "theme",
	"icon": "clock",
	"description": "By when the product arrives, ordered now, from the carriers that deliver it.",
	"keywords": [
		"shop",
		"product",
		"delivery",
		"shipping",
		"cutoff"
	],
	"textdomain": "orillacart",
	"attributes": {
		"productId": {
			"type": "integer",
			"default": 0
		},
		"preview": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "orillacart-blocks",
	"viewScript": "orillacart-storefront",
	"style": "orillacart-storefront"
}
