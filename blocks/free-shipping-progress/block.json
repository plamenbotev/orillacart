{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "orillacart/free-shipping-progress",
	"title": "Free shipping progress",
	"category": "widgets",
	"icon": "car",
	"description": "How much more the shopper’s cart needs to ship free, with a bar, or that it ships free. Shows nothing while no free shipping rate would take the cart.",
	"keywords": [
		"shop",
		"shipping",
		"cart"
	],
	"textdomain": "orillacart",
	"attributes": {
		"showBar": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "orillacart-blocks",
	"viewScript": "orillacart-storefront",
	"style": "orillacart-storefront"
}
