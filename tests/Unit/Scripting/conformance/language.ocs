# The language, one function a feature. ConformanceTest runs each and checks what it returns.

extension "conformance" {
  name: "Conformance"
  needs: { orders: read }
}

fn arithmetic() {
  return [1 + 2 * 3, 7 / 2, 7 // 2, 7 % 3, -(2 + 3), 2.5 * 2, 10 / 2, "3" + 4]
}

fn money_math(price, qty) {
  let total = money(price) * qty
  let discounted = total - money("1.50")
  return [total, discounted, discounted / 3, money("2") > money("1.5"), (money("2") == money("2.0000")), total|round(1)]
}

fn strings(name) {
  let greeting = "Hello, " ~ name ~ "!"
  return [greeting, greeting|upper, greeting|length, name starts with "Ad", name ends with "a", "a" in name, "x,y,z"|split(","), ["a", "b"]|join("-"), "  pad "|trim, "ada"|capitalize, "élan"|upper, greeting|slice(0, 5), greeting|replace({ "Hello": "Bye" })]
}

fn comparisons() {
  return [1 == 1.0, 1 == "1", "a" < "b", 2 >= 2, null == false, [1, 2] == [1, 2], 1 != 2, 3 in [1, 2, 3], 4 not in [1, 2]]
}

fn logic(a, b) {
  return [a and b, a or b, not a, a ?? "d", null ?? "d", a ? "y" : "n", a ?: "fallback", b ? "only"]
}

fn control(n) {
  let out = []
  let i = 0
  while i < n {
    i = i + 1
    if i % 2 == 0 { continue }
    if i > 7 { break }
    out = out|merge([i])
  }
  for k, v in { a: 1, b: 2 } {
    out = out|merge([k ~ v])
  }
  for x in 1..3 { out = out|merge([x * 10]) }
  for nothing in null { out = ["never"] }
  return out
}

fn maps(m) {
  let copy = m
  copy.a = 10
  copy.nested.deep = "set"
  copy["k e y"] = true
  let fromKeys = { ("dyn" ~ 1): 1, 2: "two" }
  return [m.a, copy.a, copy.nested.deep, copy["k e y"], m.missing, m.missing.deeper, fromKeys.dyn1, fromKeys[2], keys(copy), len(copy), copy|keys|length, values({ x: 1 })]
}

fn lists() {
  let l = [3, 1, 2]
  return [l|sort, l|reverse, l|first, l|last, l|slice(1), [1, [2, 3]]|length, l|map(fn(x) { return x * 2 }), l|sort(fn(a, b) { return b - a }), min(l), max(4, 9, 2), [[1], [2]]|first, l|join]
}

fn tests_and_filters(v) {
  return [v is empty, v is not empty, v is null, v is defined, 3 is odd, 4 is even, [] is list, { a: 1 } is map, money("1") is money, "x" is string, 1 is number, [1] is iterable, v|default("d"), 1234.5|number(2, ",", "."), 2.567|round(2), (-3)|abs]
}

fn closures(base) {
  let add = fn(x) { return x + base }
  let twice = fn(f, x) { return f(f(x)) }
  return [add(1), twice(add, 1), [1, 2]|map(add)]
}

fn calls_helpers(n) {
  return square(n) + square(2)
}

fn square(x) { return x * x }

fn failures(kind) {
  try {
    if kind == "refused" { fail refused("no way", { code: 7 }) }
    if kind == "text" { fail "plain message" }
    if kind == "error" { let z = 1 / 0 }
    if kind == "type" { let q = [1] + 2 }
    return "fine"
  } catch e {
    return [e.kind, e.message, e.data]
  }
}

fn uncaught() {
  fail unavailable("down")
}

fn runaway() {
  let n = 0
  while true { n = n + 1 }
}

fn hungry() {
  let s = "x"
  for i in 1..40 { s = s ~ s }
  return s|length
}

fn json_roundtrip(v) {
  return json.parse(json.text(v))
}

fn times() {
  let start = time.parse("2026-01-31")
  return [time.today(), time.add(start, "1 month"), time.format(start, "d.m.Y"), time.diff(start, time.add(start, "2 hours")), time.now() > start]
}

fn needs_permission() {
  return shop.orders.find(12)
}

fn conversions() {
  return [str(12), str(true), str(null), str(money("1.5")), num("2.5"), num("7"), "n: " ~ 1.5 ~ null ~ true]
}
